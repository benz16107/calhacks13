[Unit]
Description=The page on the box's own screen (a placeholder until the portal lands)
ConditionKernelCommandLine=!box.install
Wants=box-firstboot.service
After=box-firstboot.service
RequiresMountsFor=/etc/box
StartLimitIntervalSec=0

[Service]
DynamicUser=yes
LoadCredential=pairing:/etc/box/pairing.json
ExecStart=/usr/local/bin/node --experimental-strip-types --disable-warning=ExperimentalWarning /usr/local/lib/box-os/screen.ts
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
