# Factory's Droid CLI (the agent worker) may not ship inside GurtOS images, so each machine downloads it once it
# has a network, with the version pin and checksum in core/setup.sh, and keeps a copy on the data partition.
# Tasks that need Droid wait for it with a clear message; nothing else does.
[Unit]
Description=Download the Droid CLI for agent tasks
ConditionKernelCommandLine=!box.install
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
# Type=exec, not oneshot: a oneshot holds multi-user.target (and "Bootup is not yet finished") until it ends, and the
# download can take minutes on a slow network. A stalled one is cut by curl's own limits (CURL_HOME below), and Restart tries again.
Type=exec
RemainAfterExit=yes
Environment=CURL_HOME=/usr/local/lib/box-os/droid-curl
ExecStart=/usr/local/lib/box-os/box-droid
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
