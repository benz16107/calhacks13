# The box's disk: an ESP (BOX-ESP), two system slots (box-a, box-b) and box-data. The running slot is /, named on
# the kernel command line. Everything that must outlive a system update lives on box-data, bind-mounted in place.
LABEL=BOX-ESP        /boot/efi                vfat  umask=0077,nofail,x-systemd.device-timeout=10s  0 2
LABEL=box-data       /data                    ext4  nofail,x-systemd.device-timeout=10s             0 2
/data/box            /var/lib/box             none  bind,nofail,x-systemd.requires-mounts-for=/data  0 0
/data/etc-box        /etc/box                 none  bind,nofail,x-systemd.requires-mounts-for=/data  0 0
/data/spacetimedb    /var/lib/spacetimedb     none  bind,nofail,x-systemd.requires-mounts-for=/data  0 0
/data/spacetime-cli  /root/.config/spacetime  none  bind,nofail,x-systemd.requires-mounts-for=/data  0 0
/data/journal        /var/log/journal         none  bind,nofail,x-systemd.requires-mounts-for=/data  0 0
