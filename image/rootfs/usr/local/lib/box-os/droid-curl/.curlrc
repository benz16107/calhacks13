# curl's limits for box-droid.service, read through CURL_HOME. A download slower than 20 KB/s for a minute is cut, and
# curl tries it again 3 times; then box-droid waits and starts over. The whole download (about 300 MB) may take up to
# 4 hours, so a slow line still gets there.
connect-timeout = 20
speed-limit = 20000
speed-time = 60
max-time = 14400
retry = 3
retry-delay = 5
