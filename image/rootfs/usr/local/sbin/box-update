#!/bin/bash
# Whole-system updates with rollback. The disk holds two systems, slots A and B. The box runs from one. An update
# is written to the other, which starts once on trial and becomes the default only if the box comes up healthy.
#   box-update status
#   box-update apply <root.sqfs | https://.../root-<arch>.sqfs> [--no-reboot]
#   box-update rollback      make the other slot the default again, and restart into it
#   box-update confirm       box-confirm.service runs this at every start
# An update is root-<arch>.sqfs from image/build with its .sha256 and .sig beside it. The .sig must verify
# against /etc/box-os/update.pub, the build machine's key, and the .sha256 must match.
set -euo pipefail
env=/boot/efi/boot/grub/grubenv
state=/data/update
work=/run/box-update
cur=$(sed -n 's/.*box\.slot=\([ab]\).*/\1/p' /proc/cmdline)
other() { [ "$1" = a ] && echo b || echo a; }
build() { sed -n 's/^BUILD=//p' "$1/etc/box-os/release" 2>/dev/null || true; }
die() { echo "box-update: $*" >&2; exit 1; }
report() {
  echo "box-update: $*"
  for t in /dev/ttyS0 /dev/ttyAMA0; do { echo "box: $*" > $t; } 2>/dev/null || true; done
}
peek() { # mount slot $1 read-only at $work/$1 and print the path, or nothing if it holds no system
  mkdir -p $work/$1
  mountpoint -q $work/$1 || mount -o ro LABEL=box-$1 $work/$1 2>/dev/null || return 0
  if [ -e $work/$1/boot/vmlinuz ]; then echo $work/$1; else umount $work/$1; fi
}

case ${1:-status} in
status)
  [ -n "$cur" ] || die "the box is running from its install disc, not a disk"
  echo "running:  slot $cur, build $(build /)"
  o=$(other $cur) p=$(peek $o)
  if [ -n "$p" ]; then echo "other:    slot $o, build $(build $p)"; umount $p; else echo "other:    slot $o, empty"; fi
  echo "default:  slot $(grub-editenv $env list | sed -n 's/^saved_entry=//p')"
  if [ -f $state/trial ]; then echo "on trial: slot $(cut -d' ' -f1 $state/trial)"; fi
  if [ -f $state/last ]; then echo "last:     $(cat $state/last)"; fi
  ;;

apply)
  [ -n "${2:-}" ] || die "usage: box-update apply <root.sqfs or URL>"
  [ -n "$cur" ] || die "the box is running from its install disc; install it first"
  new=$(other $cur)
  mkdir -p $state $work
  if [[ $2 == http://* || $2 == https://* ]]; then
    for ext in "" .sha256 .sig; do curl -fsSL --retry 3 -o $state/new.sqfs$ext "$2$ext"; done
    file=$state/new.sqfs
  else
    file=$2
    for ext in .sha256 .sig; do cp "$2$ext" $state/new.sqfs$ext; done
  fi
  openssl pkeyutl -verify -pubin -inkey /etc/box-os/update.pub -rawin -in $state/new.sqfs.sha256 \
    -sigfile $state/new.sqfs.sig >/dev/null || die "the update is not signed by this box's build key"
  [ "$(cut -d' ' -f1 $state/new.sqfs.sha256)" = "$(sha256sum < "$file" | cut -d' ' -f1)" ] ||
    die "the update does not match its .sha256"

  echo "box-update: writing slot $new"
  dev=/dev/disk/by-partlabel/box-$new
  mountpoint -q $work/$new && umount $work/$new
  mkfs.ext4 -q -F -L box-$new $dev
  mkdir -p $work/$new && mount $dev $work/$new
  unsquashfs -f -q -no-progress -d $work/$new "$file"
  root=$work/$new
  [ -e $root/boot/vmlinuz ] && [ -e $root/opt/box/core/box.ts ] || die "the update is not a box system"
  # The new system keeps this machine's identity and the box's task users (core makes them, uids 30000-39999).
  cp -a /etc/machine-id $root/etc/
  cp -a /etc/ssh/ssh_host_* $root/etc/ssh/ 2>/dev/null || true
  for n in $(awk -F: '$3 >= 30000 && $3 <= 39999 { print $1 }' /etc/passwd); do
    for f in passwd group shadow gshadow; do
      grep -q "^$n:" $root/etc/$f || grep "^$n:" /etc/$f >> $root/etc/$f || true
    done
  done
  sync && umount $root
  [ "$file" = $state/new.sqfs ] && rm -f $file

  grub-editenv $env set next_entry=$new
  echo "$new $(date -u +%FT%TZ)" > $state/trial
  report "slot $new holds the update. It starts once on trial and stays only if the box is healthy."
  [ "${3:-}" = --no-reboot ] || systemctl reboot
  ;;

rollback)
  [ -n "$cur" ] || die "the box is running from its install disc"
  o=$(other $cur) p=$(peek $o)
  [ -n "$p" ] || die "slot $o holds no system"
  umount $p
  grub-editenv $env set saved_entry=$o
  rm -f $state/trial
  echo "$(date -u +%FT%TZ) rolled back by hand from slot $cur to slot $o" > $state/last
  report "rolling back to slot $o"
  systemctl reboot
  ;;

confirm)
  health=
  for _ in $(seq 150); do # up to 5 minutes: the first start publishes the SpacetimeDB module
    health=$(curl -fsS --max-time 2 http://127.0.0.1:7700/health 2>/dev/null) && [[ $health == *'"ok":true'* ]] && break
    health=
    sleep 2
  done
  where=${cur:+slot $cur}
  where=${where:-the install disc}
  where+=", build $(build /), $(cat /proc/sys/kernel/hostname)"
  if [ -n "$health" ]; then report "up and healthy on $where: $health"
  else report "NOT healthy after 5 minutes on $where"; fi
  [ -n "$cur" ] && [ -f $state/trial ] || { [ -n "$health" ]; exit; }

  trial=$(cut -d' ' -f1 $state/trial)
  rm -f $state/trial
  if [ "$trial" != "$cur" ]; then
    echo "$(date -u +%FT%TZ) the update in slot $trial did not start; still on slot $cur" > $state/last
    report "the update in slot $trial did not start, so the box stayed on slot $cur"
  elif [ -n "$health" ]; then
    grub-editenv $env set saved_entry=$cur
    echo "$(date -u +%FT%TZ) slot $cur, build $(build /), confirmed" > $state/last
    report "update confirmed: slot $cur is now the default"
  else
    echo "$(date -u +%FT%TZ) slot $cur, build $(build /), was not healthy; rolled back to slot $(other $cur)" > $state/last
    report "the update in slot $cur is not healthy. Rolling back to slot $(other $cur)."
    systemctl reboot
  fi
  ;;

*) die "usage: box-update status | apply <file or URL> | rollback | confirm" ;;
esac
