#!/bin/bash
# Opens the port of each Settings, Sharing service while it listens, and closes it when it stops (E-6 in
# docs/ux/parity.md). /etc/nftables.conf stays default-drop; this only fills two sets that it accepts from.
# Listeners owned by task users (uids 30000 to 39999) never count, and neither do loopback-only ones: an agent
# cannot open a port, and its own outbound limits (the box service's table) are not touched.
#   box-sharing-fw          keep the sets current (box-sharing-fw.service)
#   box-sharing-fw status   print the open ports
# sshd: ssh.socket holds port 22 for the real sshd, so it is read from its state. The others are read from the
# listening sockets of the Sharing programs: gnome-remote-desktop (3389), gnome-user-share's web server (3490),
# rygel (media sharing), avahi-daemon (mDNS, printer and device discovery), cupsd (a shared printer, 631).
set -uo pipefail
programs='sshd|gnome-remote-d|rygel|avahi-daemon|cupsd|apache2'

ports() { # prints "tcp 22" / "udp 5353" lines
  ss -H -ltunpe 2>/dev/null | awk -v progs="$programs" '
    { proto = $1; addr = $5; n = split(addr, a, ":"); port = a[n]; host = substr(addr, 1, length(addr) - length(port) - 1)
      if (host ~ /^(127\.|\[::1\])/) next
      uid = ""; for (i = 6; i <= NF; i++) if ($i ~ /^uid:/) uid = substr($i, 5)
      if (uid != "" && uid >= 30000 && uid <= 39999) next
      if (match($0, /\(\("[^"]+"/) == 0) next
      prog = substr($0, RSTART + 3, RLENGTH - 4)
      if (prog !~ "^(" progs ")$") next
      if (prog == "avahi-daemon" && port != 5353) next # its other sockets use random ports
      print proto, port }'
  if systemctl is-active --quiet ssh.socket ssh.service 2>/dev/null; then echo tcp 22; fi
}

apply() {
  local list tcp udp
  list=$(ports | sort -u)
  tcp=$(awk '$1 == "tcp" { printf "%s%s", s, $2; s = ", " }' <<< "$list")
  udp=$(awk '$1 == "udp" { printf "%s%s", s, $2; s = ", " }' <<< "$list")
  {
    echo "flush set inet gurtos sharing_tcp"
    echo "flush set inet gurtos sharing_udp"
    [[ -z $tcp ]] || echo "add element inet gurtos sharing_tcp { $tcp }"
    [[ -z $udp ]] || echo "add element inet gurtos sharing_udp { $udp }"
  } | nft -f - 2>/dev/null
}

case ${1:-run} in
  status) echo "tcp: $(nft list set inet gurtos sharing_tcp | sed -n 's/.*elements = { \(.*\) }.*/\1/p')"
          echo "udp: $(nft list set inet gurtos sharing_udp | sed -n 's/.*elements = { \(.*\) }.*/\1/p')" ;;
  run) while true; do apply; sleep 3; done ;;
  *) echo "usage: box-sharing-fw [status]" >&2; exit 2 ;;
esac
