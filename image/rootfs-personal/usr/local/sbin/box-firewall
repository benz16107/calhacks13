#!/bin/bash
# box-firewall status | locked | open
#   locked  (default) inbound only for replies and ping, and the GurtOS API from private networks (/etc/nftables.conf)
#   open    anything a person turns on in Settings works on the home network; only GurtOS's own ports stay private
set -euo pipefail
case ${1:-status} in
  locked|open) mkdir -p /etc/box; echo "$1" > /etc/box/firewall-mode; systemctl restart nftables; echo "firewall: $1" ;;
  status) echo "firewall: $(cat /etc/box/firewall-mode 2>/dev/null || echo locked)" ;;
  *) echo "usage: box-firewall status | locked | open" >&2; exit 2 ;;
esac
