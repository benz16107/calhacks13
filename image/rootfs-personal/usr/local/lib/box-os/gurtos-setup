#!/bin/bash
# GurtOS Setup on GurtOS Personal: at login, for the computer's owner (the person in the sudo group), once GNOME's
# own first-login setup is finished, open GurtOS's setup wizard if the box says setup is not done. The wizard is
# the portal's; the Box window (personal/box-ui.py) shows it to the owner until setup is done. Runs from
# /etc/xdg/autostart in the person's session, and does nothing once setup is done.
set -euo pipefail
id -nG | tr ' ' '\n' | grep -qx sudo || exit 0
# GNOME's own pages come first: wait up to 10 minutes for them to finish.
for _ in $(seq 120); do [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/gnome-initial-setup-done" ] && break; sleep 5; done
done=$(curl -sf --max-time 5 http://127.0.0.1:7700/api/setup | python3 -c 'import json, sys; print(json.load(sys.stdin)["done"])' || echo unknown)
[ "$done" = False ] || exit 0
if [ -x /opt/box/personal/box-ui.py ]; then exec /opt/box/personal/box-ui.py app; fi
exec xdg-open http://127.0.0.1:7700/
