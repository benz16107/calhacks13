#!/bin/bash
# The computer's name after GNOME's first-run setup (box-owner.service runs this when the first account appears).
# Ubuntu's first-run setup has a "Computer name" field. It fills it with the account name until the person types
# their own, and sets that as the static hostname when they leave the page, before it makes the account. The
# pretty hostname, which Settings' About shows, is still gurt-<id> from first boot.
#   - The name is the account name: the person chose nothing. Put the box's own name back, gurt-<id>.
#   - The person typed a name: keep it, and make the pretty hostname the same, so Settings shows it too.
# A pretty name the person set in Settings themselves (not gurt-*) is left alone. Runs before the box learns its
# owner, so the box restarts with the right name.
set -euo pipefail
pub=/etc/box/identity.pub
passwd=/etc/passwd

main() {
  local cur pretty id
  cur=$(hostnamectl --static)
  pretty=$(hostnamectl --pretty)
  id=$(openssl pkey -pubin -in $pub -outform DER | sha256sum | cut -c1-6)
  if awk -F: -v h="$cur" '$3 >= 1000 && $3 < 30000 && $1 == h { found = 1 } END { exit !found }' $passwd; then
    hostnamectl --static set-hostname "gurt-$id"
    hostnamectl --pretty set-hostname "gurt-$id"
  elif [ -n "$cur" ] && [ "$cur" != "gurt-$id" ] && [[ -z $pretty || $pretty == gurt-* ]]; then
    hostnamectl --pretty set-hostname "$cur"
  fi
}

# Sourced (by image/unit) it only defines the functions above.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
