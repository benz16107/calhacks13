#!/usr/bin/env bash
# Boot-test the install disc in a fresh QEMU VM on this machine (no root needed):
#   1. it installs on an empty disk and restarts into the box, which must report healthy on the serial console
#   2. the disc is removed and the plug pulled: the box must start from its own disk, healthy, same identity
#   3. with --debug (a debug build: sshd with your key): a system update to slot B, then a broken update that
#      must roll back by itself
#   image/test [--debug] [--uefi]   x86_64 with KVM. BIOS by default, like most cloud VMs.
#   image/test --arm64               arm64 with UEFI, emulated (no KVM), so about 5 times slower
#   image/test --personal            the Personal edition. With --debug it also checks that a person's account, sudo
#                                    and files survive the update.
# Needs qemu-system (x86_64, or aarch64 for --arm64), qemu-img, ssh, curl, nc and ImageMagick's convert.
# It takes the build from /var/lib/box-image/out on this machine, or from BUILD_HOST over ssh.
# Env: ISO (a local ISO instead), BUILD_HOST (an ssh host that ran image/build), TEST_DIR (default ~/.cache/box-image-test)
set -Eeuo pipefail
trap 'echo "test: FAILED at line $LINENO: $BASH_COMMAND"' ERR
uefi= arch=x86_64 debug= edition=server-
for a in "$@"; do
  case $a in
    --uefi) uefi=1 ;; --debug) debug=-debug ;; --arm64) arch=arm64 ;; --personal) edition=personal- ;;
    *) echo "usage: image/test [--debug] [--uefi] [--arm64] [--personal]" >&2; exit 2 ;;
  esac
done
name=$edition$arch$debug
slow=1 accel=(-enable-kvm -cpu host)
[[ $arch == arm64 ]] && slow=5
# Without KVM (a cloud VM, for instance) x86_64 is emulated too, and everything takes about five times longer.
[[ $arch == x86_64 && ! -w /dev/kvm ]] && { slow=5 accel=(-accel tcg,thread=multi -cpu max); }
dir=${TEST_DIR:-$HOME/.cache/box-image-test}
out=/var/lib/box-image/out
mkdir -p "$dir"
iso=${ISO:-$dir/gurtos-$name.iso}
if [[ -z ${ISO:-} ]]; then
  from=${BUILD_HOST:+$BUILD_HOST:}$out
  files=("$from/gurtos-$name.iso")
  [[ -n $debug ]] && files+=("$from/gurtos-$name.sqfs" "$from/gurtos-$name.sqfs.sha256" "$from/gurtos-$name.sqfs.sig")
  rsync -t --info=progress2 "${files[@]}" "$dir/"
fi
# The VM takes 2.5 GB. So the rest of this machine keeps room, one test VM runs at a time, and only once 6 GB are free.
exec 7>"$dir/vm.lock"
flock -n 7 || { echo "test: another test VM is running here; waiting for it"; flock 7; }
until (( $(free -g | awk '/^Mem:/ { print $7 }') >= 6 )); do echo "test: waiting for 6 GB of free memory"; sleep 30; done
run=$dir/run-$(date +%m%d-%H%M%S)
mkdir -p "$run"
echo "test: $run"
qemu-img create -q -f qcow2 "$run/disk.qcow2" $([[ $edition == personal- ]] && echo 40G || echo 24G)
share=$(dirname "$(readlink -f "$(command -v qemu-system-x86_64)")")/../share/qemu
port=${SSH_PORT:-2299}
common=(-name box-test -m 2560 -smp 4 -display none
  -drive "if=none,id=cd,media=cdrom,readonly=on,file=$iso" -drive "if=none,id=hd,file=$run/disk.qcow2"
  -device virtio-blk-pci,drive=hd,bootindex=1
  -serial "file:$run/serial.log" -monitor "unix:$run/mon.sock,server,nowait"
  -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$port-:22,hostfwd=tcp:127.0.0.1:$((port + 1000))-:3000,hostfwd=tcp:127.0.0.1:$((port + 2000))-:7700,hostfwd=tcp:127.0.0.1:$((port + 3000))-:3389,hostfwd=tcp:127.0.0.1:$((port + 4000))-:3490,hostfwd=tcp:127.0.0.1:$((port + 5000))-:7701"
  -daemonize -pidfile "$run/qemu.pid")
if [[ $arch == arm64 ]]; then
  cp "$share/edk2-arm-vars.fd" "$run/vars.fd"
  qemu-system-aarch64 -machine virt -cpu max -accel tcg,thread=multi "${common[@]}" \
    -drive "if=pflash,format=raw,readonly=on,file=$share/edk2-aarch64-code.fd" -drive "if=pflash,format=raw,file=$run/vars.fd" \
    -device virtio-scsi-pci -device scsi-cd,drive=cd,bootindex=0 \
    -device virtio-gpu-pci -device qemu-xhci -device usb-kbd
else
  fw=()
  if [[ -n $uefi ]]; then
    cp "$share/edk2-i386-vars.fd" "$run/vars.fd"
    fw=(-drive "if=pflash,format=raw,readonly=on,file=$share/edk2-x86_64-code.fd" -drive "if=pflash,format=raw,file=$run/vars.fd")
  fi
  qemu-system-x86_64 -machine q35 "${accel[@]}" "${common[@]}" "${fw[@]}" -device ide-cd,drive=cd,bootindex=0 \
    -device virtio-vga
fi
trap 'kill $(cat "$run/qemu.pid") 2>/dev/null || true' EXIT

mon() { echo "$*" | nc -NU "$run/mon.sock" >/dev/null; }
shot() { mon "screendump $run/$1.ppm" && sleep 1 && convert "$run/$1.ppm" "$run/$1.png" && rm "$run/$1.ppm" && echo "test: screenshot $run/$1.png"; }
count() { grep -c "$1" "$run/serial.log" 2>/dev/null || true; }
wait_for() { # <pattern> <how many times in the log> <seconds>
  for _ in $(seq $(($3 * slow))); do [[ $(count "$1") -ge $2 ]] && return 0; sleep 1; done
  echo "test: FAILED, timed out waiting for: $1"
  tail -40 "$run/serial.log"
  exit 1
}
box_id() { grep 'box: up and healthy' "$run/serial.log" | sed -n "${1}p" | sed -n 's/.* \(gurt-[0-9a-f]*\):.*/\1/p'; }
vm() { ssh -q -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=40 root@127.0.0.1 "$@"; }

wait_for 'box-install: Installing GurtOS' 1 300
echo "test: $(grep -o 'Installing GurtOS.*' "$run/serial.log")"
wait_for 'box-install: Installed' 1 600
echo "test: installed, restarting into the box"
wait_for 'box: up and healthy' 1 600
grep 'box: up and healthy' "$run/serial.log" | tail -1
sleep $((15 * slow)) && shot screen-1

echo "test: removing the disc and pulling the plug"
mon "eject -f cd"
mon system_reset
if [[ $edition == personal- ]]; then # the boot splash
  for i in 1 2 3 4; do sleep $((4 * slow)); shot boot-$i; done
fi
wait_for 'box: up and healthy' 2 600
[[ $(box_id 1) == "$(box_id 2)" && -n $(box_id 1) ]] || { echo "test: FAILED, the box's identity changed"; exit 1; }
echo "test: back up after the power cut, same box $(box_id 2)"

# The firewall, from outside the VM. QEMU's network makes us a private address (10.0.2.2), like a home network.
stdb=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://127.0.0.1:$((port + 1000))/v1/ping" || true)
[[ $stdb == 000 ]] || { echo "test: FAILED, SpacetimeDB on 3000 answered from outside ($stdb)"; exit 1; }
echo "test: SpacetimeDB (3000) does not answer from outside"
curl -sf --max-time 8 "http://127.0.0.1:$((port + 2000))/api/health" | grep -q '"ok":true' ||
  { echo "test: FAILED, the box's API (7700) does not answer from a private network"; exit 1; }
echo "test: the box's API (7700) answers from a private network"
vm 'nft list chain inet gurtos input | grep -q "tcp dport 7701 ip saddr @private4 accept"' || { echo "test: FAILED, the firewall does not allow the setup port (7701) from private networks"; exit 1; }
vm 'nft list chain inet gurtos input | grep -q "tcp dport 7701 accept"' && { echo "test: FAILED, the setup port (7701) is open to the public internet"; exit 1; }
if vm 'test -f /opt/box/core/gurtos.ts'; then
  vm 'test -x /usr/local/bin/gurtos && test -f /usr/share/doc/gurtos/AGENT-SETUP.md' ||
    { echo "test: FAILED, command setup has no gurtos command or AGENT-SETUP.md on the disc"; exit 1; }
  if [[ $edition != personal- ]]; then # the listener opens only when someone at the screen asks for a setup code
    code7701() { curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://127.0.0.1:$((port + 5000))$1" || true; }
    [[ $(code7701 /api/settings) == 000 ]] || { echo "test: FAILED, the setup port answers before anyone asked for a code"; exit 1; }
    vm 'curl -sf -X POST --unix-socket /var/lib/box/api.sock http://box/api/setup/code' | grep -q '"code"' ||
      { echo "test: FAILED, the box gave no setup code"; exit 1; }
    [[ $(code7701 /api/settings) == 401 ]] || { echo "test: FAILED, the setup port is not the box's API with a token required (got $(code7701 /api/settings))"; exit 1; }
    vm 'curl -sf -X POST --unix-socket /var/lib/box/api.sock http://box/api/setup/stop' >/dev/null || { echo "test: FAILED, setup/stop did not work"; exit 1; }
    for _ in $(seq 8); do [[ $(code7701 /api/settings) == 000 ]] && break; sleep 1; done
    [[ $(code7701 /api/settings) == 000 ]] || { echo "test: FAILED, the setup port stays open after Stop"; exit 1; }
  fi
  echo "test: command setup: gurtos, AGENT-SETUP.md and the setup port are in place"
fi
vm 'systemctl show box-droid -p Type --value | grep -qx exec && grep -q max-time /usr/local/lib/box-os/droid-curl/.curlrc && systemctl show box-droid -p Environment --value | grep -q CURL_HOME && ! systemctl show box-droid -p After --value | grep -q network-online' ||
  { echo "test: FAILED, the Droid download has no time limit or holds the boot"; exit 1; }
echo "test: the Droid download is a background unit with curl time limits"

if [[ $name != *-debug ]]; then
  echo "test: PASSED (a release build has no ssh, so the update steps need --debug)"
  exit 0
fi
screen=box-kiosk
[[ $edition == personal- ]] && screen=gdm
vm "systemctl is-active box spacetimedb $screen; box-update status"
vm 'grep -h "^PRETTY_NAME\|^ID" /etc/os-release; hostname; grep -o "menuentry \"[^\"]*\"" /boot/efi/boot/grub/grub.cfg' | sed 's/^/test: /'
if [[ $edition == personal- ]]; then
  echo "test: GNOME's setup would make the first account an administrator. Make one the same way, through AccountsService"
  vm 'busctl call org.freedesktop.Accounts /org/freedesktop/Accounts org.freedesktop.Accounts CreateUser ssi ana "Ana Test" 1 >/dev/null &&
    sleep 2 && cp -aT /etc/skel /home/ana && echo kept > /home/ana/note && chown -R ana: /home/ana && id ana'
  vm 'id ana | grep -q "(sudo)"' || { echo "test: FAILED, ana is not in the sudo group"; exit 1; }
  vm 'getent group sudo | cut -d: -f4' | grep -q box- && { echo "test: FAILED, a task user has sudo"; exit 1; }
  owner() { for _ in $(seq 30); do vm 'grep -q BOX_OWNER=ana /etc/systemd/system/box.service.d/personal.conf' 2>/dev/null && return; sleep 2; done
    echo "test: FAILED, the box did not learn its owner ($1)"; exit 1; }
  owner "after the first account" && echo "test: the box knows its owner: ana"
  check() { out=$(vm "$2" 2>&1) || { echo "test: FAILED, $1"; echo "$out" | tail -n 8 | cut -c1-200; exit 1; }; }
  check "a Python error prints apport's second traceback" '! python3 -c "raise ValueError" 2>&1 | grep -q "package manager"'
  # GNOME's first run sets the static hostname: the account name unless the person typed one (box-hostname's header).
  names() { echo "s=\$(hostnamectl --static); p=\$(hostnamectl --pretty); hostnamectl --static set-hostname $1; /usr/local/lib/box-os/box-hostname;
    r=\$(hostnamectl --static)/\$(hostnamectl --pretty); hostnamectl --static set-hostname \$s; hostnamectl --pretty set-hostname \$p; echo \$r"; }
  check "a computer named after the account is not renamed back" "$(names ana) | grep -q '^gurt-[0-9a-f]*/gurt-'"
  check "a computer name typed in first run is not applied" "[ \$($(names my-laptop)) = my-laptop/my-laptop ]"
  check "Settings still has the Ubuntu Desktop panel (wrapper missing)" 'grep -q XDG_CURRENT_DESKTOP=GNOME /usr/bin/gnome-control-center /usr/libexec/gnome-control-center-search-provider && test -x /usr/libexec/gnome-control-center.real && test -x /usr/libexec/gnome-control-center-search-provider.real'
  # What a stock Ubuntu desktop has (docs/ux/parity.md): printing, an app store that survives updates, accounts, zram.
  check "no printing system, or its folders are not on the data partition" 'test -x /usr/sbin/cupsd && findmnt -n -o SOURCE /etc/cups | grep -q cups-etc && findmnt -n -o SOURCE /var/lib/cups | grep -q cups-var'
  check "no Flathub for a new account" 'runuser -u ana -- env HOME=/home/ana flatpak remotes --user | grep -q flathub'
  check "no app store, or a snap or deb plugin came with it" 'test -x /usr/bin/gnome-software && ! test -e /usr/bin/snap && ! dpkg -s gnome-software-plugin-deb >/dev/null 2>&1'
  check "Ubuntu's Software Updater or update notifier is installed" '! dpkg -s update-manager >/dev/null 2>&1 && ! dpkg -s update-notifier >/dev/null 2>&1 && grep -q Prompt=never /etc/update-manager/release-upgrades'
  check "the desktop's packages are left for apt autoremove" '[ -z "$(apt-get -s autoremove | grep "^Remv")" ]'
  check "no zram swap or oomd" 'swapon --show | grep -q zram && systemctl is-active systemd-oomd'
  check "no online accounts or sharing" 'test -x /usr/libexec/goa-daemon && test -x /usr/libexec/gnome-remote-desktop-daemon'
  check "no H.264 or AAC decoder" 'gst-inspect-1.0 avdec_h264 >/dev/null && gst-inspect-1.0 avdec_aac >/dev/null'
  # Settings, Sharing (E-6): a Sharing program's port opens while it listens and closes when it stops; a task
  # user's listener never opens, and a task user still cannot reach out beyond its rules (the box table).
  # The programs are stood in for by python3 under the Sharing programs' names, as a file name sets the process name.
  fake() { echo "cd /tmp && ln -sf /usr/bin/python3 /tmp/$1 && (setsid ${3:-} /tmp/$1 -m http.server $2 --bind 0.0.0.0 >/dev/null 2>&1 &)"; }
  answers() { curl -s -o /dev/null --max-time 4 "http://127.0.0.1:$1/"; }
  answers $((port + 3000)) && { echo "test: FAILED, port 3389 answers before Sharing is on"; exit 1; }
  vm "$(fake gnome-remote-d 3389)"
  for _ in $(seq 10); do answers $((port + 3000)) && break; sleep 1; done
  answers $((port + 3000)) || { echo "test: FAILED, turning on a Sharing program does not open its port"; exit 1; }
  vm 'pkill -f "[/]tmp/gnome-remote-d" || true'
  for _ in $(seq 10); do answers $((port + 3000)) || break; sleep 1; done
  answers $((port + 3000)) && { echo "test: FAILED, turning off a Sharing program leaves its port open"; exit 1; }
  vm "$(fake gnome-remote-d 3490 'setpriv --reuid=30001 --regid=30001 --clear-groups')" ; sleep 8
  answers $((port + 4000)) && { echo "test: FAILED, a task user's listener was opened to the network"; exit 1; }
  vm 'pkill -f "[/]tmp/gnome-remote-d" || true'
  check "a task user can reach out" '! setpriv --reuid=30001 --regid=30001 --clear-groups python3 -c "import socket; socket.create_connection((\"10.0.2.2\", 22), 4)"'
  echo "test: a Sharing port opens and closes with its program; a task user's port stays shut and it cannot reach out"
  echo "test: kernel $(vm uname -r)"
  check "no BOX_URL" 'grep -q "^BOX_URL=http" /run/box-os/box.env'
  check "no pretty hostname" 'grep -q "^PRETTY_HOSTNAME=gurt-" /etc/machine-info'
  check "Adwaita icons outside Ubuntu's session" '! sudo -u ana env -u XDG_CURRENT_DESKTOP gsettings get org.gnome.desktop.interface icon-theme | grep -q Adwaita'
  echo "test: no apport hook, BOX_URL set, pretty hostname set, no Adwaita icons outside Ubuntu's session"
fi

droid() { for _ in $(seq $((60 * slow))); do vm "/usr/local/bin/droid --version >/dev/null 2>&1 && [ -x /data/droid/droid ] && grep -qx state=ready /run/box-os/droid" && return; sleep 5; done
  echo "test: FAILED, no Droid after 5 minutes ($1)"; exit 1; }
droid "first boot" && echo "test: the image has no Droid, and the box downloaded it"
if [[ $edition == personal- ]]; then
  for _ in $(seq $((120 * slow))); do vm '[ -x /opt/box/voice-venv/bin/python ] && [ -e /opt/box/voice-models/.ready ] && mountpoint -q /opt/box/voice-models' 2>/dev/null && break; sleep 5; done
  vm 'mountpoint -q /opt/box/voice-models && [ -x /opt/box/voice-venv/bin/python ] && du -sh /data/voice-venv /data/voice-models' ||
    { echo "test: FAILED, no speech model after 10 minutes"; exit 1; }
  echo "test: the speech model was downloaded onto the data partition"
fi
echo "test: system update to slot B"
vm 'mkdir -p /data/update && cat > /data/update/root.sqfs' < "$dir/gurtos-$name.sqfs"
vm 'cat > /data/update/root.sqfs.sha256' < "$dir/gurtos-$name.sqfs.sha256"
vm 'cat > /data/update/root.sqfs.sig' < "$dir/gurtos-$name.sqfs.sig"
vm 'box-update apply /data/update/root.sqfs' || true
wait_for 'box: update confirmed: slot b' 1 600
vm 'box-update status'
droid "after the update" && echo "test: Droid is back after the update, from the data partition"
if [[ $edition == personal- ]]; then
  vm 'id ana | grep -q "(sudo)" && grep -qx kept /home/ana/note' || { echo "test: FAILED, ana or her files did not survive the update"; exit 1; }
  echo "test: ana, her sudo and her files survived the update"
  owner "after the update" && echo "test: and the new system knows its owner too"
fi
shot screen-2

echo "test: a broken update (its box service never starts) must roll back to slot B by itself"
vm 'box-update apply /data/update/root.sqfs --no-reboot && mount LABEL=box-a /mnt &&
  ln -sf /dev/null /mnt/etc/systemd/system/box.service && umount /mnt && systemctl reboot' || true
wait_for 'box: the update in slot a is not healthy' 1 900
wait_for 'box: up and healthy on slot b' 2 600
vm 'box-update status'
echo "test: PASSED"
