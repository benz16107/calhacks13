#!/usr/bin/env bash
# Build GurtOS: an installer ISO and a signed update image, for x86_64 or arm64, Server or Personal.
#   image/build                    GurtOS Server for x86_64, on this machine
#   image/build arm64              GurtOS Server for arm64 (natively on arm64; elsewhere emulated, about an hour)
#   image/build all                both
#   image/build personal [arch]    GurtOS Personal: GNOME desktop, the person's own account, the Box layer
#   BUILD_SHELL='ssh my-vm' image/build          on another machine instead, e.g. an arm64 VM for arm64:
#   BUILD_SHELL='ssh my-arm-vm' image/build arm64
# It builds as root on an Ubuntu 24.04 machine (this one, or BUILD_SHELL's), so use a VM or a machine set aside for
# it: it installs build tools, mounts loop devices and runs chroots.
# Env: BOX_VERSION     the version people see (os-release, the disc menu), e.g. 0.1.0-preview. Default: the date.
#      BOX_UPDATE_KEY  an ed25519 private key file (PEM) to sign updates with; the image trusts its public half.
#                      Default: a key the build machine makes once, in /var/lib/box-image/update-signing.key.
#      BOX_TIMEZONE    the time zone until someone changes it (default UTC)
#      BOX_TEST_DISC_HOST  an ssh host name (a laptop). When set with BUILD_SHELL 'ssh <host> <command in a VM there>', the
#                      disc is copied to ~/box-os/<name>-test.iso on that host and its checksum checked. Unset for releases.
#      BOX_SSH_KEY     a public key file. Adds sshd with that key for root. Debug builds only.
# Outputs on the build machine, in /var/lib/box-image/out: gurtos-<edition>-<arch>.iso, the install disc, and
# gurtos-<edition>-<arch>.sqfs (+ .sha256, .sig), the update image. Edition is server or personal. Debug builds end
# in -debug, so they cannot be mistaken for a release.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ ${1:-} != --here ]]; then
  edition=
  [[ ${1:-} == personal ]] && { edition=personal; shift; }
  key=$([[ -n ${BOX_SSH_KEY:-} ]] && base64 -w0 "$BOX_SSH_KEY" || true)
  ukey=$([[ -n ${BOX_UPDATE_KEY:-} ]] && base64 -w0 "$BOX_UPDATE_KEY" || true)
  dest=/opt/box-image-src/${edition:+$edition-}${1:-x86_64}${key:+-debug}
  echo "build: ${BUILD_SHELL:-this machine}, in $dest"
  {
    # One build per source folder at a time: a second one waits instead of deleting the first one's files.
    echo "set -e; mkdir -p /var/lib/box-image; exec 9>/var/lib/box-image/src-${dest##*/}.lock"
    echo "flock -n 9 || { echo 'build: another build uses $dest; waiting for it'; flock 9; }"
    echo "rm -rf $dest; mkdir -p $dest"
    echo "base64 -d <<'EOF' | tar -xzf - -C $dest"
    git ls-files -co --exclude-standard | while IFS= read -r f; do [[ -e $f ]] && printf '%s\n' "$f"; done |
      tar -czf - --mode=go+rX,go-w -T - | base64 # task users must read /opt/box, whatever this checkout's umask
    echo EOF
    echo "echo '$(git rev-parse --short HEAD)$(git diff --quiet HEAD -- . || echo +dirty)' > $dest/image/.commit"
    [[ -n $key ]] && echo "echo $key | base64 -d > $dest/image/.ssh-key"
    # The update key goes outside the source folder (which is copied into the image) and is deleted afterwards.
    k=$dest.update-key
    [[ -n $ukey ]] && echo "trap 'rm -f $k' EXIT; (umask 077; echo $ukey | base64 -d > $k)"
    for arch in $([[ ${1:-x86_64} == all ]] && echo x86_64 arm64 || echo "${1:-x86_64}"); do
      printf "BOX_TIMEZONE=%q BOX_VERSION=%q BOX_UPDATE_KEY=%q %q --here %q %q\n" \
        "${BOX_TIMEZONE:-}" "${BOX_VERSION:-}" "${ukey:+$k}" "$dest/image/build" "$arch" "$edition"
    done
  } | ${BUILD_SHELL:-} sudo bash -s || exit
  # BOX_TEST_DISC_HOST=<ssh host>: BUILD_SHELL runs commands on that host (ssh <host> <command in the VM>). Put the
  # disc in ~/box-os on that host as <name>-test.iso, and check it arrived whole. Release builds leave it unset.
  if [[ -n ${BOX_TEST_DISC_HOST:-} && ${1:-x86_64} != all ]]; then
    host=$BOX_TEST_DISC_HOST
    iso=gurtos-${edition:-server}-${1:-x86_64}${key:+-debug}
    want=$(${BUILD_SHELL} sudo sha256sum /var/lib/box-image/out/$iso.iso | cut -d' ' -f1)
    ssh "$host" "${BUILD_SHELL##* $host }" sudo cat /var/lib/box-image/out/$iso.iso '>' '~/box-os/'$iso-test.iso.part \
      '&&' mv '~/box-os/'$iso-test.iso.part '~/box-os/'$iso-test.iso
    got=$(ssh "$host" "shasum -a 256 ~/box-os/$iso-test.iso" | cut -d' ' -f1)
    [[ $want == "$got" ]] || { echo "build: ~/box-os/$iso-test.iso on the laptop does not match the build ($got, not $want)" >&2; exit 1; }
    echo "build: ~/box-os/$iso-test.iso on the laptop, sha256 ${got:0:12}"
  fi
  exit
fi

[[ $(id -u) == 0 ]] || exec sudo "$0" "$@"
(. /etc/os-release && [[ $ID == ubuntu && $VERSION_ID == 24.04 ]]) ||
  { echo "build: this needs Ubuntu 24.04 (here: $(. /etc/os-release && echo "$PRETTY_NAME")). Use BUILD_SHELL." >&2; exit 2; }
version=${BOX_VERSION:-$(date -u +%Y.%m.%d)}
[[ $version =~ ^[0-9A-Za-z][0-9A-Za-z.+~-]*$ ]] || { echo "build: BOX_VERSION may hold letters, digits and . + ~ -" >&2; exit 2; }
arch=${2:-x86_64}
case $arch in
  x86_64) deb=amd64 mirror=http://archive.ubuntu.com/ubuntu grub="grub-pc-bin grub-efi-amd64-bin" ;;
  arm64) deb=arm64 mirror=http://ports.ubuntu.com/ubuntu-ports grub=grub-efi-arm64-bin ;;
  *) echo "unknown arch $arch (x86_64 or arm64)" >&2; exit 2 ;;
esac
src=$PWD
edition=${3:-server}
name=$arch
[[ $edition == personal ]] && name=personal-$arch
[[ -f $src/image/.ssh-key ]] && name+=-debug
product=gurtos-$edition-$arch${name#*"$arch"} # the outputs' names; $name stays the build cache's
Edition=${edition^}
top=/var/lib/box-image
work=$top/$name
out=$top/out
root=$work/root
mkdir -p "$work" "$out"
say() { echo "build $name: $*"; }
# One build per work folder at a time. Two at once would delete each other's roots while they are mounted.
exec 8>"$work.lock"
flock -n 8 || { say "another build of $name is running; waiting for it"; flock 8; }

# The whole OS. Everything else on the image comes from core/setup.sh, core/install.sh and image/rootfs/.
# Server keeps Ubuntu's general kernel; a laptop needs the newer one (hardware from the last year or two).
kernel=linux-image-generic
[[ $edition == personal ]] && kernel=linux-image-generic-hwe-24.04
base_packages="systemd systemd-sysv systemd-resolved systemd-timesyncd libpam-systemd dbus udev kmod passwd
  $kernel initramfs-tools zstd $grub grub2-common
  e2fsprogs dosfstools gdisk squashfs-tools util-linux procps iproute2
  nftables ripgrep rsync curl ca-certificates xz-utils openssl age eject"
components="main universe"
[[ $edition == personal ]] && components="main restricted universe multiverse" # codecs and drivers people install later
if [[ $edition == server ]]; then
  packages="$base_packages qrencode plymouth
  cage seatd python3-gi gir1.2-webkit2-4.1 libegl-mesa0 libgl1-mesa-dri fonts-dejavu-core"
else
  # Ubuntu's GNOME desktop without snaps (so GNOME Web instead of Firefox), GNOME's first-boot account setup,
  # sudo for the person, and what personal/install.sh needs, so it finds everything installed.
  packages="$base_packages fonts-dejavu-core libegl-mesa0 libgl1-mesa-dri
  ubuntu-desktop-minimal network-manager gnome-initial-setup sudo locales apparmor epiphany-browser
  gnome-terminal gnome-text-editor gnome-keyring libpam-gnome-keyring gnome-system-monitor gnome-calculator eog evince
  policykit-desktop-privileges xdg-desktop-portal-gnome xdg-utils gvfs-fuse bluez libglib2.0-bin
  yaru-theme-gnome-shell yaru-theme-gtk yaru-theme-icon yaru-theme-sound fonts-ubuntu fonts-noto-color-emoji
  gsettings-ubuntu-schemas ubuntu-wallpapers
  python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 gir1.2-webkit-6.0 gir1.2-gtk-3.0 gir1.2-ayatanaappindicator3-0.1
  gnome-shell-extension-appindicator python3-nautilus
  papirus-icon-theme bibata-cursor-theme gnome-console plymouth plymouth-label plymouth-theme-spinner qrencode
  python3-venv espeak-ng alsa-utils libnotify-bin
  dconf-cli librsvg2-common
  cups cups-browsed cups-filters cups-pk-helper ipp-usb system-config-printer-udev avahi-daemon bluez-cups printer-driver-all
  flatpak gnome-software gnome-software-plugin-flatpak
  gnome-online-accounts gnome-online-accounts-gtk evolution-data-server
  gnome-remote-desktop rygel gnome-user-share
  systemd-zram-generator systemd-oomd unattended-upgrades
  orca brltty speech-dispatcher speech-dispatcher-espeak-ng ibus ibus-gtk3 ibus-gtk4 ibus-libpinyin ibus-table ibus-m17n
  gnome-accessibility-themes
  power-profiles-daemon iio-sensor-proxy switcheroo-control fprintd libpam-fprintd bolt fwupd modemmanager usbmuxd ntfs-3g
  gvfs-backends mesa-vulkan-drivers gnome-power-manager rtkit
  gnome-disk-utility baobab gnome-logs gnome-clocks gnome-characters gnome-font-viewer seahorse gnome-startup-applications
  gstreamer1.0-libav gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-vaapi"
fi
[[ -f $src/image/.ssh-key ]] && packages+=" openssh-server" # debug builds only

host_tools="mmdebstrap squashfs-tools xorriso mtools grub-common apt-cacher-ng fonts-dejavu-mono" # apt-cacher-ng: packages download once per build machine
[[ $edition == personal ]] && host_tools+=" gettext libglib2.0-bin libglib2.0-dev-bin" # the first-boot text and GDM theme
[[ $arch == x86_64 ]] && host_tools+=" grub-pc-bin grub-efi-amd64-bin" # so x86 builds need an x86 build VM
[[ $arch == arm64 && $(uname -m) != aarch64 ]] && host_tools+=" qemu-user-static"
missing=$(for p in $host_tools; do dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done)
[[ -z $missing ]] || { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $missing >/dev/null; }
# Packages come through apt-cacher-ng on this machine (port 3142, cache in /var/cache/apt-cacher-ng), so a second
# build, or the other edition, downloads only what it has not fetched before. Without it they come straight from the mirror.
proxy=
curl -s --max-time 3 -o /dev/null http://127.0.0.1:3142/ && proxy=http://127.0.0.1:3142
aptproxy=(--aptopt='Acquire::Retries "5"') # a flaky connection retries instead of failing the build
[[ -z $proxy ]] || aptproxy+=(--aptopt="Acquire::http::Proxy \"$proxy\";")

mounts_under() { awk -v d="$1" '$5 == d || index($5, d "/") == 1 { print $5 }' /proc/self/mountinfo; }
# Unmount everything at or under $1, or stop the build. A chroot's /dev is the host's own /dev, bind-mounted: an
# rm -rf or rsync --delete through a mount left behind deletes the build machine's device nodes.
unmount_under() {
  for p in /proc/[0-9]*; do # processes a chroot step left running keep its mounts busy
    if [[ $(readlink "$p/root" 2>/dev/null) == "$1" ]]; then kill -9 "${p#/proc/}" 2>/dev/null || true; fi
  done
  mounts_under "$1" | sort -r | while read -r m; do umount "$m" 2>/dev/null || umount -l "$m"; done
  if [[ -n $(mounts_under "$1") ]]; then
    echo "build: still mounted under $1, so nothing there is deleted or copied:" >&2
    mounts_under "$1" >&2
    exit 1
  fi
}

mounted=()
mount_root() {
  mount -t proc proc "$1/proc"; mount -t sysfs sys "$1/sys"; mount -t tmpfs tmpfs "$1/run"
  mount --rbind /dev "$1/dev"; mount --make-rslave "$1/dev"
  mounted+=("$1")
  rm -f "$1/etc/resolv.conf"; cp -L /etc/resolv.conf "$1/etc/resolv.conf"
}
umount_all() { for r in "${mounted[@]}"; do unmount_under "$r"; done; mounted=(); }
trap umount_all EXIT
in_root() {
  chroot "$root" /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/root LANG=C.UTF-8 DEBIAN_FRONTEND=noninteractive "$@"
}

# 1. The base: Ubuntu 24.04 plus the box's own dependencies. Cached until the package list or core/setup.sh changes.
stamp=$(printf '%s\nno-droid\n' "$packages" | cat - core/setup.sh | sha256sum | cut -c1-12)
base=$work/base-$stamp
if [[ ! -d $base ]]; then
  say "base $stamp: Ubuntu 24.04 from $mirror"
  unmount_under "$work/base.tmp"
  rm -rf "$work/base.tmp"
  mmdebstrap "${aptproxy[@]}" --arch=$deb --variant=minbase --include="$(echo $packages | tr ' ' ,)" \
    --dpkgopt='path-exclude=/usr/share/doc/*' --dpkgopt='path-include=/usr/share/doc/*/copyright' \
    --dpkgopt='path-exclude=/usr/share/man/*' \
    noble "$work/base.tmp" \
    "deb $mirror noble $components" "deb $mirror noble-updates $components" "deb $mirror noble-security $components"
  root=$work/base.tmp
  mount_root "$root"
  [[ -z $proxy ]] || echo "Acquire::http::Proxy \"$proxy\"; Acquire::Retries \"5\";" > "$root/etc/apt/apt.conf.d/99box-proxy"
  mkdir -p "$root/tmp/core" && cp core/setup.sh "$root/tmp/core/"
  in_root env BOX_NO_DROID=1 bash /tmp/core/setup.sh # Droid's license forbids shipping it: box-droid fetches it
  umount_all
  rm -rf "$root/tmp/core" "$root/etc/apt/apt.conf.d/99box-proxy"
  mv "$work/base.tmp" "$base"
fi

# 2. The root: the base, the box service installed by core/install.sh, and image/rootfs on top.
say "root"
root=$work/root
mkdir -p "$root"
unmount_under "$base"
unmount_under "$root"
rsync -aHAX --delete "$base/" "$root/"
mount_root "$root"
[[ -z $proxy ]] || echo "Acquire::http::Proxy \"$proxy\"; Acquire::Retries \"5\";" > "$root/etc/apt/apt.conf.d/99box-proxy"
rsync -a --exclude node_modules --exclude .git "$src/" "$root/tmp/src/"
# core/install.sh ends by asking systemd if the box is running. In an image build nothing runs yet.
printf '#!/bin/sh\n[ "$1" = is-active ] && { echo "active at boot"; exit 0; }\nexec /usr/bin/systemctl "$@"\n' \
  > "$root/usr/local/sbin/systemctl"
chmod +x "$root/usr/local/sbin/systemctl"
in_root env BOX_NO_DROID=1 /tmp/src/core/install.sh
rm "$root/usr/local/sbin/systemctl"
if [[ $edition == personal ]]; then
  if [[ -x $root/tmp/src/personal/install.sh ]]; then
    in_root env BOX_NO_VOICE=1 /tmp/src/personal/install.sh # the Box desktop layer; it promises to work in a chroot
    # The speech model (about 600 MB) would push the ISO past 2 GiB: box-voice.service fetches it at first boot,
    # onto the data partition. These folders are its mount points.
    rm -rf "$root/opt/box/voice-venv" "$root/opt/box/voice-models"
    mkdir -p "$root/opt/box/voice-venv" "$root/opt/box/voice-models"
  else
    say "no personal/install.sh in this checkout, so no Box desktop layer"
  fi
fi

if [[ $edition == server ]]; then
  rsync -a "$src/image/rootfs/" "$src/image/rootfs-server/" "$root/"
else
  # The shared files, without the Server's screen and networking, then the Personal edition's own.
  rsync -a --exclude /etc/fstab --exclude /etc/systemd/network/ --exclude /etc/systemd/system/box-kiosk.service \
    --exclude /usr/local/lib/box-os/kiosk.py "$src/image/rootfs/" "$root/"
  rsync -a "$src/image/rootfs-personal/" "$root/"
fi
mkdir -p "$root/etc/box-os"
# The boot menus' large font (one file for the disc and the installed disk). GRUB draws text on a grid as wide as the
# font's widest letter, so it must be a monospaced one: DejaVu Sans spaced every letter far apart (I-9).
grub-mkfont -s 22 -o "$root/usr/local/lib/box-os/gurtos.pf2" /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf

if [[ $edition == personal ]]; then
  # GNOME's first-boot setup ends on "All done! GurtOS is ready to be used." and a Start button, before the GurtOS
  # setup that follows. gettext also looks in a catalog for en_US, so say what happens next. The ids are the program's.
  po=$work/initial-setup.po
  cat > "$po" <<'POEOF'
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "All done!"
msgstr "Almost there"

msgid "%s is ready to be used."
msgstr "Your account is ready. One more step: set up %s."

msgid "_Start Using %s"
msgstr "_Continue"

msgid "Setup Complete"
msgstr "Your account"
POEOF
  install -d "$root/usr/share/locale/en_US/LC_MESSAGES"
  msgfmt -o "$root/usr/share/locale/en_US/LC_MESSAGES/gnome-initial-setup.mo" "$po"

  # The login screen and the first-boot setup use Yaru's shell theme: an orange accent and a flat grey backdrop.
  # Make a copy with GurtOS's blue (#2F64A6, a lighter and a darker step) and the wallpaper colour (#27313F), and make
  # it the theme GDM and the default shell use. The GurtOS session names its own theme and is not touched.
  g=$root/usr/share/gnome-shell/theme/Yaru/gnome-shell-theme.gresource
  t=$work/gdm-theme
  rm -rf "$t"; mkdir -p "$t/res"
  gresource list "$g" | while read -r r; do
    f=$t/res/${r#/org/gnome/shell/theme/}; mkdir -p "$(dirname "$f")"; gresource extract "$g" "$r" > "$f"
  done
  find "$t/res" -name '*.css' -exec sed -i -e 's/#e95420/#2f64a6/Ig; s/#ef8661/#6d92c1/Ig; s/#d34615/#265085/Ig' {} +
  find "$t/res" -name '*.css' -exec perl -0pi -e 's/(#lockDialogGroup \{\s*background-color: )#222222/${1}#27313f/g' {} +
  grep -q 2f64a6 "$t/res/Yaru/gnome-shell.css" || { say "the GDM theme has no accent colour to change"; exit 1; }
  { echo '<gresources><gresource prefix="/org/gnome/shell/theme">'
    (cd "$t/res" && find . -type f | sed 's|^\./||; s|.*|<file>&</file>|')
    echo '</gresource></gresources>'; } > "$t/theme.gresource.xml"
  install -d "$root/usr/share/gnome-shell/theme/GurtOS"
  glib-compile-resources --sourcedir="$t/res" --target="$root/usr/share/gnome-shell/theme/GurtOS/gnome-shell-theme.gresource" "$t/theme.gresource.xml"
  in_root update-alternatives --install /usr/share/gnome-shell/gdm-theme.gresource gdm-theme.gresource \
    /usr/share/gnome-shell/theme/GurtOS/gnome-shell-theme.gresource 30
  in_root update-alternatives --install /usr/share/gnome-shell/gnome-shell-theme.gresource gnome-shell-theme.gresource \
    /usr/share/gnome-shell/theme/GurtOS/gnome-shell-theme.gresource 30
fi
if [[ $edition == personal ]]; then
  # Ubuntu's Software Updater and its notifier offer a release upgrade (to a different Ubuntu) and know nothing of
  # GurtOS's whole-system updates (E-3): they are removed in the chroot below. gnome-software depends on Software &
  # Updates (software-properties-gtk), so that stays installed and is hidden from menus, search and login.
  for f in software-properties-gtk software-properties-drivers software-properties-livepatch; do
    [[ -f $root/usr/share/applications/$f.desktop ]] && sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$root/usr/share/applications/$f.desktop"
  done
  for f in ubuntu-advantage-notification gnome-software-service; do
    [[ -f $root/etc/xdg/autostart/$f.desktop ]] && echo 'Hidden=true' >> "$root/etc/xdg/autostart/$f.desktop"
  done
  # About shows the distributor's logo from here (Ubuntu's patch); the GurtOS wordmark replaces it (rootfs-personal).
  sed -i 's/^DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION="GurtOS Personal"/' "$root/etc/lsb-release"
  # Flathub, as each person's own installation (under their home, which is on the data partition), so an app they
  # install survives a system update. New accounts copy this from /etc/skel.
  curl -fsSL --retry 3 --connect-timeout 20 --max-time 120 https://dl.flathub.org/repo/flathub.flatpakrepo -o "$root/tmp/flathub.flatpakrepo"
  install -d "$root/etc/skel"
  in_root env HOME=/etc/skel flatpak remote-add --user --if-not-exists flathub /tmp/flathub.flatpakrepo
  [[ -f $root/etc/skel/.local/share/flatpak/repo/config ]] || { say "no Flathub remote for new accounts"; exit 1; }
  # No snaps and no apt store: an install through GNOME Software must go to Flathub, never to a deb or snap.
  if in_root dpkg -s snapd >/dev/null 2>&1 || in_root dpkg -s gnome-software-plugin-snap >/dev/null 2>&1 \
     || in_root dpkg -s gnome-software-plugin-deb >/dev/null 2>&1; then
    say "a snap or deb plugin came in with GNOME Software"; exit 1
  fi
  # the printing system, and the cups folders' mount points (rootfs-personal/etc/fstab)
  in_root test -x /usr/sbin/cupsd
fi
key=${BOX_UPDATE_KEY:-$top/update-signing.key} # never inside the image
[[ -n ${BOX_UPDATE_KEY:-} || -f $key ]] || (umask 077; openssl genpkey -algorithm ed25519 -out "$key")
openssl pkey -in "$key" -noout -text 2>/dev/null | grep -q '^ED25519 Private-Key' ||
  { say "the update key $key is not an ed25519 private key"; exit 2; }
openssl pkey -in "$key" -pubout -out "$root/etc/box-os/update.pub"
build_id="$(date -u +%Y%m%d-%H%M)-$(cat "$src/image/.commit" 2>/dev/null || echo local)"
printf 'BUILD=%s\nARCH=%s\n' "$build_id" "$arch" > "$root/etc/box-os/release"
# The time zone until someone changes it; updates keep whatever it is then.
tz=${BOX_TIMEZONE:-UTC}
[[ -e $root/usr/share/zoneinfo/$tz ]] || { say "unknown time zone $tz"; exit 1; }
ln -sf "/usr/share/zoneinfo/$tz" "$root/etc/localtime"
echo "$tz" > "$root/etc/timezone"
# The product's name. Ubuntu's codename stays, so apt and its tools still know the base.
cat > "$root/usr/lib/os-release" <<OSREL
NAME="GurtOS"
PRETTY_NAME="GurtOS $Edition $version"
VERSION="$version ($Edition)"
VERSION_ID="$version"
BUILD_ID="$build_id"
VARIANT="$Edition"
VARIANT_ID=$edition
ID=gurtos
ID_LIKE=ubuntu
VERSION_CODENAME=noble
UBUNTU_CODENAME=noble
OSREL
[[ $edition == personal ]] && echo 'LOGO=gurtos-logo' >> "$root/usr/lib/os-release" # personal/theme installs it
ln -sf ../usr/lib/os-release "$root/etc/os-release"
printf 'GurtOS %s %s \\n \\l\n\n' "$Edition" "$version" > "$root/etc/issue"
printf 'GurtOS %s %s\n' "$Edition" "$version" > "$root/etc/issue.net"
[[ $edition == personal ]] && printf 'EDITION=personal\nSLOT_MB=12288\n' >> "$root/etc/box-os/release"

if [[ $edition == server ]]; then in_root bash -euo pipefail -c '
  useradd --system --home-dir /var/lib/kiosk --create-home --shell /usr/sbin/nologin kiosk
  usermod -p "!" root
  # State lives on the data partition. These are its mount points; what the image put there is hidden at boot.
  rm -rf /etc/box /var/lib/box /var/lib/spacetimedb /root/.config/spacetime
  mkdir -p /data /boot/efi /etc/box /var/lib/box /var/lib/spacetimedb /root/.config/spacetime /var/log/journal
  systemctl enable nftables systemd-networkd systemd-resolved seatd box-firstboot box-droid box-kiosk box-confirm box-install >/dev/null 2>&1
  # No login prompt anywhere: the screen is the box, and no human account exists.
  systemctl mask getty@.service serial-getty@.service autovt@.service console-getty.service >/dev/null 2>&1
  # The boot splash. initramfs-tools takes the theme from this alternative, so it must be set before the rebuild.
  update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
    /usr/share/plymouth/themes/gurtos-server/gurtos-server.plymouth 200 >/dev/null
  update-alternatives --set default.plymouth /usr/share/plymouth/themes/gurtos-server/gurtos-server.plymouth
  update-initramfs -u -k all >/dev/null
  lsinitramfs /boot/initrd.img-* | grep -q gurtos-server/logo.png
  cd /boot
  ln -sf "$(ls vmlinuz-* | sort -V | tail -1)" vmlinuz
  ln -sf "$(ls initrd.img-* | sort -V | tail -1)" initrd.img
'
fi
if [[ $edition == personal ]]; then in_root bash -euo pipefail -c '
  usermod -p "!" root
  # State lives on the data partition. These are its mount points; what the image put there is hidden at boot.
  rm -rf /etc/box /var/lib/box /var/lib/spacetimedb /root/.config/spacetime
  mkdir -p /data /boot/efi /etc/box /var/lib/box /var/lib/spacetimedb /root/.config/spacetime /var/log/journal
  # No Software Updater or update notifier (E-3). Both come with the ubuntu-desktop-minimal metapackage, which goes with
  # them. Everything installed is marked as wanted first, so nothing else goes, and an apt autoremove later cannot
  # take the desktop.
  apt-mark manual $(apt-mark showauto) >/dev/null
  apt-get purge -y -qq update-manager update-notifier >/dev/null
  if dpkg -s update-manager >/dev/null 2>&1 || dpkg -s update-notifier >/dev/null 2>&1; then echo "Ubuntu'"'"'s updater is still installed" >&2; exit 1; fi
  dpkg -s gnome-shell gdm3 gnome-control-center gnome-software gnome-initial-setup >/dev/null
  locale-gen en_US.UTF-8 >/dev/null
  update-locale LANG=en_US.UTF-8
  # Only the GurtOS session at the login screen: the Ubuntu one has no GurtOS top bar.
  rm -f /usr/share/wayland-sessions/ubuntu*.desktop /usr/share/xsessions/ubuntu*.desktop
  # The boot splash: personal/theme sets the theme, /etc/plymouth/plymouthd.conf names it, and update-initramfs
  # below puts it in place. `splash` is on the kernel line in grub.cfg.
  grep -q " splash " /usr/local/lib/box-os/grub.cfg
  systemctl enable box-voice
  dpkg-divert --local --rename --add --divert /usr/libexec/gnome-control-center.real /usr/bin/gnome-control-center
  install -m 0755 /usr/local/lib/box-os/gnome-control-center-wrapper /usr/bin/gnome-control-center
  test -x /usr/libexec/gnome-control-center.real
  s=/usr/libexec/gnome-control-center-search-provider
  dpkg-divert --local --rename --add --divert $s.real $s
  install -m 0755 /usr/local/lib/box-os/gnome-control-center-wrapper $s
  test -x $s.real
  dconf update
  test -f /etc/dconf/db/gurtos-setup
  systemctl enable nftables box-firstboot box-droid box-confirm box-install box-owner.service box-owner.path box-sharing-fw >/dev/null 2>&1
  # The distributor logo GNOME shows (its first-boot setup, Settings > About) is GurtOS, not Ubuntu.
  logo=/usr/share/icons/hicolor/symbolic/apps/dev.box.Box-symbolic.svg
  if [ -f $logo ]; then
    for t in Yaru Adwaita; do
      f=$(find /usr/share/icons/$t -name start-here-symbolic.svg | head -1)
      [ -z "$f" ] || cp $logo "$f"
      gtk-update-icon-cache -q -f /usr/share/icons/$t 2>/dev/null || true
    done
  fi
  glib-compile-schemas /usr/share/glib-2.0/schemas
  systemctl set-default graphical.target >/dev/null 2>&1
  update-initramfs -u -k all >/dev/null
  cd /boot
  ln -sf "$(ls vmlinuz-* | sort -V | tail -1)" vmlinuz
  ln -sf "$(ls initrd.img-* | sort -V | tail -1)" initrd.img
'
fi
if [[ -f $src/core/gurtos.ts ]]; then
  # Command setup (core/gurtos.ts): the guide for an agent, and a `gurtos` command for one that has a shell here.
  [[ -f $src/AGENT-SETUP.md ]] || { echo "build: core/gurtos.ts is here but AGENT-SETUP.md is not" >&2; exit 1; }
  install -D -m 644 "$src/AGENT-SETUP.md" "$root/usr/share/doc/gurtos/AGENT-SETUP.md"
  printf '#!/bin/sh\nexec node --experimental-strip-types --disable-warning=ExperimentalWarning /opt/box/core/gurtos.ts "$@"\n' > "$root/usr/local/bin/gurtos"
  chmod 755 "$root/usr/local/bin/gurtos"
fi
if [[ $edition == personal ]]; then
  # Personal only: the ports of the Settings, Sharing services that are on (box-sharing-fw fills the two sets).
  sed -i -e 's|^\t# personal: sharing sets|\tset sharing_tcp { type inet_service; }\n\tset sharing_udp { type inet_service; }|' \
         -e 's|^\t\t# personal: sharing rules|\t\ttcp dport @sharing_tcp accept\n\t\tudp dport @sharing_udp accept|' "$root/etc/nftables.conf"
  grep -q 'tcp dport @sharing_tcp accept' "$root/etc/nftables.conf" && grep -q 'set sharing_udp' "$root/etc/nftables.conf"
fi
if [[ -f $src/image/.ssh-key ]]; then
  say "debug build: sshd with a root key"
  install -d -m 700 "$root/root/.ssh"
  install -m 600 "$src/image/.ssh-key" "$root/root/.ssh/authorized_keys"
  echo 'DEBUG=sshd-with-a-root-key' >> "$root/etc/box-os/release"
  sed -i 's/# debug builds: ssh/tcp dport 22 accept # debug build/' "$root/etc/nftables.conf"
fi

# Every machine makes its own identity on first boot.
: > "$root/etc/machine-id"
rm -f "$root/var/lib/dbus/machine-id" "$root"/etc/ssh/ssh_host_*
umount_all
rm -f "$root/etc/apt/apt.conf.d/99box-proxy"
rm -rf "$root/tmp/"* "$root/var/lib/apt/lists/"* "$root/var/cache/"*/* "$root/root/.npm" "$root/root/.cache"
ln -sf ../run/systemd/resolve/stub-resolv.conf "$root/etc/resolv.conf"

[[ ! -e $root/usr/local/bin/droid ]] || { say "Droid is in the image, and its license does not allow shipping it"; exit 1; }

# 3. The update image: the whole root as one squashfs, hashed and signed.
say "$product.sqfs"
sq=$out/$product.sqfs
unmount_under "$root"
mksquashfs "$root" "$sq" -noappend -comp zstd -quiet
(cd "$out" && sha256sum "$product.sqfs" > "$product.sqfs.sha256")
openssl pkeyutl -sign -inkey "$key" -rawin -in "$sq.sha256" -out "$sq.sig"

# 4. The installer ISO: GRUB for BIOS and UEFI, the kernel, and the same squashfs as a live root.
say "$product.iso"
iso=$work/iso
rm -rf "$iso"; mkdir -p "$iso/boot/grub" "$iso/box"
cp -L "$root/boot/vmlinuz" "$root/boot/initrd.img" "$iso/boot/"
ln "$sq" "$iso/box/root.sqfs"
cp "$sq.sha256" "$sq.sig" "$iso/box/"
sed "s/@NAME@/GurtOS $Edition/g; s/@VERSION@/$version/g" "$src/image/iso-grub.cfg" > "$iso/boot/grub/grub.cfg"
install -D -m 644 "$root/usr/local/lib/box-os/gurtos.pf2" "$iso/boot/grub/fonts/gurtos.pf2"
dirs=()
[[ $arch == arm64 ]] && dirs=(-d "$root/usr/lib/grub/arm64-efi")
grub-mkrescue "${dirs[@]}" -o "$out/$product.iso" "$iso" -volid GURTOS -iso-level 3 2>&1 | grep -v '^xorriso : UPDATE' || true
[[ -s $out/$product.iso ]]
rm -rf "$iso"
say "done, build $build_id"
ls -lh "$out/$product.iso" "$sq"
