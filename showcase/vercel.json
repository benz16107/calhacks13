{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/clips/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tracks/nessie/",
      "destination": "/tracks/hyphenate/",
      "permanent": true
    },
    {
      "source": "/tracks/nessie",
      "destination": "/tracks/hyphenate/",
      "permanent": true
    }
  ]
}
