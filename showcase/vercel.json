{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/clips/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tracks/nessie/",
      "destination": "/tracks/hyphenate/",
      "permanent": true
    },
    {
      "source": "/tracks/nessie",
      "destination": "/tracks/hyphenate/",
      "permanent": true
    },
    {
      "source": "/tracks/godaddy/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tracks/godaddy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "https://gurtos.com/terms/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://gurtos.com/terms/",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "https://gurtos.com/privacy/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://gurtos.com/privacy/",
      "permanent": true
    }
  ]
}
