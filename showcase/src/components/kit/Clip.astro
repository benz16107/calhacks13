---
// A short, silent, looping clip of the real app. `name` picks one from src/data/clips.json (its poster and caption come with it);
// or pass `src` (an mp4 under /public, or a .gif) and `poster`. Reduced motion shows the still and does not play.
import clips from '../../data/clips.json';

interface Props {
  name?: string;
  src?: string;
  poster?: string;
  alt?: string;
  caption?: string;
  width?: number;
  height?: number;
}
type Clip = { name: string; title: string; caption: string; seconds?: number; width?: number; height?: number; poster?: string };
const p = Astro.props;
const c = p.name ? (clips as Clip[]).find((x) => x.name === p.name) : undefined;
if (p.name && !c) throw new Error(`Clip: no clip named "${p.name}" in src/data/clips.json`);
const src = p.src ?? `/clips/${c!.name}.mp4`;
const poster = p.poster ?? c?.poster ?? `/clips/${c?.name}.jpg`;
const isGif = src.endsWith('.gif');
const label = p.alt ?? c?.title ?? 'Screen recording';
const caption = p.caption ?? (c ? `<strong>${c.title}.</strong> ${c.caption}` : undefined);
const width = p.width ?? c?.width;
const height = p.height ?? c?.height;
---

<figure class="k-clip">
  {
    isGif ? (
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset={poster} />
        <img src={src} alt={label} width={width} height={height} loading="lazy" />
      </picture>
    ) : (
      <div class="k-clip-frame">
        <video muted loop playsinline autoplay preload="metadata" poster={poster} width={width} height={height} aria-label={label} data-clip>
          <source src={src} type="video/mp4" />
        </video>
        <button type="button" class="k-clip-toggle" data-clip-toggle aria-label="Pause the clip">Pause</button>
      </div>
    )
  }
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .k-clip {
    margin: var(--space-5) 0 var(--space-6);
  }
  .k-clip-frame {
    position: relative;
  }
  video,
  picture img {
    width: 100%;
    height: auto;
    display: block;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
  }
  .k-clip-toggle {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    font: inherit;
    font-size: 0.82rem;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    cursor: pointer;
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    max-width: var(--measure);
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const sync = (v: HTMLVideoElement) => {
    const b = v.parentElement!.querySelector<HTMLButtonElement>('[data-clip-toggle]')!;
    b.textContent = v.paused ? 'Play' : 'Pause';
    b.setAttribute('aria-label', v.paused ? 'Play the clip' : 'Pause the clip');
  };
  document.querySelectorAll<HTMLVideoElement>('video[data-clip]').forEach((v) => {
    const b = v.parentElement!.querySelector<HTMLButtonElement>('[data-clip-toggle]')!;
    let byUser = false;
    if (still.matches) {
      v.pause();
      v.removeAttribute('autoplay');
      byUser = true;
    }
    b.addEventListener('click', () => {
      byUser = true;
      v.paused ? v.play() : v.pause();
    });
    v.addEventListener('play', () => sync(v));
    v.addEventListener('pause', () => sync(v));
    // Do not run clips that are off screen.
    new IntersectionObserver(([e]) => {
      if (byUser) return;
      e.isIntersecting ? v.play().catch(() => {}) : v.pause();
    }).observe(v);
    sync(v);
  });
</script>
