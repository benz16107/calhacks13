---
// Technical depth behind a disclosure, so the page reads in 30 seconds and the detail is one click away.
interface Props {
  summary: string;
  open?: boolean;
}
const { summary, open = false } = Astro.props;
---

<details class="k-details" open={open}>
  <summary>{summary}</summary>
  <div class="k-details-body"><slot /></div>
</details>

<style>
  .k-details {
    margin: var(--space-4) 0;
    border-top: 1px solid var(--color-border-default);
    border-bottom: 1px solid var(--color-border-default);
    max-width: var(--measure);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: var(--space-3) 0;
  }
  .k-details-body {
    padding-bottom: var(--space-3);
  }
  .k-details-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
