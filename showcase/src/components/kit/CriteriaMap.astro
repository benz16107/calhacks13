---
// Each thing the sponsor's judges asked for, quoted, then the evidence that meets it, with links.
// items: { ask, status?: 'met' | 'partly' | 'open', how (HTML ok), evidence?: { label, href }[] }
import { slug } from './slug';

interface Props {
  sponsor?: string;
  // Where the quoted criteria come from (HTML ok).
  source?: string;
  title?: string;
  items: { ask: string; status?: 'met' | 'partly' | 'open'; how: string; evidence?: { label: string; href: string }[] }[];
}
const { sponsor, source, items } = Astro.props;
const title = Astro.props.title ?? (sponsor ? `What ${sponsor} asked for` : 'What the judges asked for');
const word = { met: 'Met', partly: 'Partly', open: 'Open' };
---

<section class="k-section" aria-labelledby={slug(title)}>
  <h2 id={slug(title)}>{title}</h2>
  {source && <p class="k-source" set:html={source} />}
  <ol class="k-crit">
    {
      items.map((c) => (
        <li>
          <blockquote>{c.ask}</blockquote>
          <div class="k-how">
            <span class={`k-state ${c.status ?? 'met'}`}>{word[c.status ?? 'met']}</span>
            <p set:html={c.how} />
            {c.evidence && c.evidence.length > 0 && (
              <ul class="k-evidence-links">
                {c.evidence.map((e) => (
                  <li>
                    <a href={e.href}>{e.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .k-section {
    margin: var(--space-7) 0;
  }
  .k-source {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    max-width: var(--measure);
    margin-top: var(--space-2);
  }
  .k-crit {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    border-top: 1px solid var(--color-border-strong);
  }
  .k-crit > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-5);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-default);
  }
  blockquote {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 3px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .k-how p {
    margin: var(--space-2) 0 0;
  }
  .k-state {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }
  .k-state.met {
    background: var(--color-state-done-bg);
    color: var(--color-state-done-fg);
  }
  .k-state.partly {
    background: var(--color-state-waiting-bg);
    color: var(--color-state-waiting-fg);
  }
  .k-state.open {
    background: var(--color-state-failed-bg);
    color: var(--color-state-failed-fg);
  }
  .k-evidence-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: 0;
    margin: var(--space-2) 0 0;
    font-size: 0.9rem;
  }
  @media (max-width: 760px) {
    .k-crit > li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
