---
// A screenshot with a caption. Click to enlarge. `dark` is the same screen in the dark theme; the page theme picks one.
// `src` is a path under src/assets/ ("repo/portal/live-agents.png" or just "portal/live-agents.png"), or an imported image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneFrame from '../../../../site/src/theme/PhoneFrame.astro';

interface Props {
  src: string | ImageMetadata;
  dark?: string | ImageMetadata;
  alt: string;
  caption?: string;
  // 'wide' fills the column, 'narrow' is a reading width, 'phone' is a tall phone shot at phone size.
  size?: 'wide' | 'narrow' | 'phone';
  // Put an iPhone frame (the shared GurtOS phone frame) round a phone screenshot. `inset` is for screens with no status bar
  // of their own, such as portal pages (set `edge` to the colour at the top of the screenshot); native iPhone app
  // screenshots already have a status bar and must not use it.
  frame?: boolean;
  inset?: boolean;
  edge?: string;
}
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/**/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const find = (s: string | ImageMetadata | undefined): ImageMetadata | undefined => {
  if (!s || typeof s !== 'string') return s as ImageMetadata | undefined;
  const hit = files[`../../assets/${s}`] ?? files[`../../assets/repo/${s}`];
  if (!hit) throw new Error(`Shot: no image at src/assets/${s}`);
  return hit.default;
};
const { alt, caption, frame = false, inset = false, edge } = Astro.props;
const size = frame ? 'phone' : (Astro.props.size ?? 'wide');
const light = find(Astro.props.src)!;
const dark = find(Astro.props.dark);
const sizes = size === 'phone' ? '320px' : '(max-width: 900px) 100vw, 900px';
---

<figure class={`k-shot ${size}`}>
  <button type="button" class:list={['k-zoom', { framed: frame }]} data-zoom aria-label={`Enlarge: ${alt}`}>
    {
      frame ? (
        <PhoneFrame src={light} dark={dark} alt={alt} inset={inset} edge={edge} sizes="320px" />
      ) : (
        <>
          <Image class="k-light" src={light} alt={alt} widths={[480, 960, 1600]} sizes={sizes} data-full={light.src} />
          {dark && <Image class="k-dark" src={dark} alt="" aria-hidden="true" widths={[480, 960, 1600]} sizes={sizes} data-full={dark.src} />}
        </>
      )
    }
  </button>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .k-shot {
    margin: var(--space-5) 0 var(--space-6);
  }
  .k-shot.narrow {
    max-width: var(--measure);
  }
  .k-shot.phone {
    max-width: 20rem;
  }
  .k-zoom {
    display: block;
    padding: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    overflow: hidden;
    cursor: zoom-in;
    width: 100%;
  }
  .k-zoom :global(img) {
    width: 100%;
    height: auto;
  }
  .k-zoom.framed {
    border: 0;
    background: transparent;
    border-radius: 0;
    overflow: visible;
  }
  .k-dark {
    display: none !important;
  }
  :global(:root[data-theme='dark']) .k-zoom:has(.k-dark) .k-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .k-zoom .k-dark {
    display: block !important;
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    max-width: var(--measure);
  }
</style>

<script>
  // One shared lightbox for every Shot on the page.
  let box: HTMLDialogElement | undefined;
  const open = (img: HTMLImageElement) => {
    if (!box) {
      box = document.createElement('dialog');
      box.className = 'k-lightbox';
      box.innerHTML = '<form method="dialog"><button aria-label="Close">Close</button></form><img alt="">';
      box.addEventListener('click', () => box!.close());
      document.body.append(box);
    }
    const big = box.querySelector('img')!;
    big.src = img.dataset.full || img.src;
    big.alt = img.alt;
    box.showModal();
  };
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-zoom]');
    if (!b) return;
    const imgs = [...b.querySelectorAll('img')];
    open(imgs.find((i) => getComputedStyle(i).display !== 'none') ?? imgs[0]);
  });
</script>

<style is:global>
  .k-lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 96vw;
    max-height: 96vh;
  }
  .k-lightbox::backdrop {
    background: rgb(10 14 18 / 0.85);
  }
  .k-lightbox img {
    display: block;
    max-width: 96vw;
    max-height: 90vh;
    margin: 0 auto;
    background: var(--color-bg-surface);
    border-radius: var(--radius-md);
  }
  .k-lightbox button {
    display: block;
    margin: 0 0 var(--space-2) auto;
    font: inherit;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    cursor: pointer;
  }
</style>
