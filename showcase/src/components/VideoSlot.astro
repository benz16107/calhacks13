---
// The page's video: the narrated YouTube video once its id is set in src/data/videos.ts, otherwise a silent
// evidence clip of the real app from src/data/clips.json. Renders nothing if neither exists.
import { VIDEOS } from '../data/videos';
import clips from '../data/clips.json';

interface Props {
  video?: string;
  clip?: string;
  label?: string;
}
const { video, clip, label = 'Video' } = Astro.props;
const youtube = video ? VIDEOS[video] : '';
type Clip = { name: string; title: string; caption: string; seconds?: number; width?: number; height?: number; poster?: string };
const c = clip ? (clips as Clip[]).find((x) => x.name === clip) : undefined;
---

{
  youtube ? (
    <figure class="video">
      <div class="frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtube}?rel=0`}
          title={label}
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        />
      </div>
      <figcaption>{label}, narrated by Ben.</figcaption>
    </figure>
  ) : c ? (
    <figure class="video">
      <video
        class="clip"
        controls
        muted
        playsinline
        loop
        preload="metadata"
        poster={c.poster ? (c.poster.startsWith('/') ? c.poster : `/clips/${c.poster}`) : `/clips/${c.name}.jpg`}
        width={c.width}
        height={c.height}
        aria-label={c.title}
      >
        <source src={`/clips/${c.name}.mp4`} type="video/mp4" />
      </video>
      <figcaption>
        <strong>{c.title}.</strong> {c.caption} Silent screen recording{c.seconds ? `, ${c.seconds} seconds` : ''}.
      </figcaption>
    </figure>
  ) : null
}

<script>
  // Clips play muted while on screen, unless the visitor asked for less motion. Controls stay available.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.5 },
    );
    document.querySelectorAll<HTMLVideoElement>('video.clip').forEach((v) => seen.observe(v));
  }
</script>

<style>
  .video {
    margin: 0 0 var(--space-6);
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-desktop-sky);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  video {
    width: 100%;
    background: var(--color-desktop-sky);
    border-radius: var(--radius-md);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    max-width: var(--measure);
  }
</style>
