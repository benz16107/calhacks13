---
// Live links a judge can open. The note says what they will see and whether it needs a sign-in.
interface Props {
  links: { label: string; href: string; note?: string }[];
  heading?: string;
}
const { links, heading = 'Open it yourself' } = Astro.props;
---

{
  links.length > 0 && (
    <section aria-labelledby="links">
      <h2 id="links">{heading}</h2>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
            {l.note && <span class="note" set:html={l.note} />}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  section {
    margin: var(--space-7) 0;
  }
  h2 {
    margin-bottom: var(--space-4);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--color-border-default);
  }
  li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-default);
  }
  a {
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .note {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    margin-top: 2px;
  }
</style>
