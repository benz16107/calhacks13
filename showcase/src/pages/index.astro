---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import VideoSlot from '../components/VideoSlot.astro';
import { LINKS } from '../data/site';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);
// "Best shown in" for the ledger, in the page's own order of editions.
const shortEd = (text: string) => {
  if (text.includes('All three')) return 'All three';
  return ['Server', 'Personal', 'Business']
    .map((n) => [n, text.indexOf(n)] as const)
    .filter(([, i]) => i >= 0)
    .sort((x, y) => x[1] - y[1])
    .map(([n]) => n)
    .join(', ');
};
---

<Base
  title="GurtOS at Cal Hacks 13.0: the tracks"
  description="GurtOS: operating systems built for AI agents. Its Cal Hacks 13.0 entries, one page per sponsor track: the problem, why it needs an operating system, the evidence and what it does not cover."
>
  <div class="wrap">
    <section id="tracks" class="intro" aria-labelledby="tracks-h">
      <p class="eyebrow">GurtOS at Cal Hacks 13.0 · a solo project by Ben Zhou</p>
      <h1 id="tracks-h">Tracks</h1>
      <p class="lead measure">
        <strong>Operating systems built for AI agents.</strong> Agents get real access to files, the web and money, and never hold your
        keys. These are GurtOS's Cal Hacks 13.0 entries, one page per sponsor track: the problem, why it needs an operating system, the
        evidence and what it does not cover. The product, its three editions and the downloads are at{' '}
        <a href={LINKS.site}>gurtos.com</a>. The evidence behind all of them is on the <a href="/evidence/">evidence page</a>.
      </p>
      <VideoSlot video="main" label="GurtOS in 3 minutes" />
      <div class="table-wrap">
        <table class="ledger">
          <thead>
            <tr><th scope="col">No.</th><th scope="col">Sponsor</th><th scope="col">Track</th><th scope="col">Best shown in</th></tr>
          </thead>
          <tbody>
            {tracks.map((t, i) => (
              <tr>
                <td class="num">{String(i + 1).padStart(2, '0')}</td>
                <th scope="row"><a href={`/tracks/${t.id}/`}>{t.data.sponsor}</a></th>
                <td>{t.data.prize}</td>
                <td>{shortEd(t.data.editions)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="measure strip-foot">The Cal Hacks prizes are best shown in all three editions. Business-led pages show the Business screens from a box seeded as the made-up Fogline Supply; the scored credit desk runs were on GurtOS Server.</p>
    </section>
  </div>
</Base>

<style>
  .intro {
    margin-top: var(--space-6);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-focus);
    margin-bottom: var(--space-4);
  }
  .intro h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }
  .intro .lead {
    margin-bottom: var(--space-6);
  }
  .ledger th[scope='row'] {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border-default);
  }
  .ledger th[scope='row'] a {
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .ledger th[scope='row'] a:hover {
    text-decoration: underline;
  }
  .ledger .num {
    font-family: var(--font-mono);
    color: var(--color-focus);
    width: 3.5rem;
  }
  .strip-foot {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }
</style>
