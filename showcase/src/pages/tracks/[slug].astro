---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Criteria from '../../components/Criteria.astro';
import VideoSlot from '../../components/VideoSlot.astro';
import Shots from '../../components/Shots.astro';
import LinkList from '../../components/LinkList.astro';
import Flow from '../../components/Flow.astro';
import Status from '../../components/Status.astro';
import { LINKS } from '../../data/site';

export async function getStaticPaths() {
  const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);
  return tracks.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: tracks[i - 1], next: tracks[i + 1], all: tracks },
  }));
}

const { entry, prev, next, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const number = String(d.order).padStart(2, '0');
const jumps = [
  ['criteria', 'Criteria'],
  ...(d.shots.length ? [['shots', 'Screenshots']] : []),
  ...(d.links.length ? [['links', 'Live links']] : []),
  ['evidence', 'Evidence'],
  ['how-it-works', 'How it works'],
  ['try-it', 'Try it'],
  ['status', 'Live or test'],
  ['limits', 'Limits'],
];
---

<Base title={`${d.sponsor}: ${d.title} | GurtOS at Cal Hacks 13.0`} description={d.summary}>
  <article class="wrap track">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/#tracks">Tracks</a> / {number} / {d.sponsor}</nav>
    <header class="head">
      <div class="head-main">
        <p class="kicker">Track {number} · Sponsor track</p>
        <h1>{d.title}</h1>
        <p class="sponsor">{d.sponsor} · {d.prize}</p>
      </div>
      <div class="best">
        <p class="label">Best shown in</p>
        <p class="best-line">{d.editions}</p>
        <p class="pitch" set:html={d.pitch} />
      </div>
      <p class="lead measure">{d.summary}</p>
      <p class="proof measure"><span class="label">Proof</span> <span set:html={d.proof} /></p>
      <nav class="jumps" aria-label="On this page">
        {jumps.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </header>
    <svg class="hills" viewBox="0 0 1920 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 70C300 0 520 35 760 8C1000 -18 1250 -34 1500 18C1750 70 1800 0 1920 26V200H0Z" fill="#8a9bad" />
      <path d="M0 130C260 75 520 115 820 85C1120 50 1300 110 1560 68C1820 26 1820 100 1920 85V200H0Z" fill="#6f8296" />
      <path d="M0 185C300 140 640 172 960 148C1280 124 1500 172 1920 132V200H0Z" fill="#586b82" />
    </svg>

    <VideoSlot video={d.video ?? entry.id} clip={d.clip} label={`${d.sponsor} video`} />

    <aside class="runs-on" aria-label="Runs on GurtOS">
      <p class="runs-h">Runs on top of GurtOS</p>
      <p class="runs-why">Today's operating systems were built for one person at a keyboard: permissions per user, not per task; secrets any process can read; the network all or nothing; no approvals, budgets, trustworthy record or rollback. GurtOS is built for agents.</p>
      <ul>
        <li><strong>A better filesystem for agents:</strong> each task gets an instant copy-on-write copy of its files (an overlay layer). Agents work in parallel without colliding, nothing is duplicated, and undo is exact: take one layer out.</li>
        <li><strong>Its own space for every agent:</strong> its own Linux user and its own copy of the files, like a worktree per task.</li>
        <li><strong>Security first:</strong> keys never reach an agent, each task reaches only its allowed hosts, spending waits for your OK, and every change is logged and undoable.</li>
        <li><strong>Light, on a computer you own:</strong> one Node service on Ubuntu, no GPU. GurtOS Server needs 4 GB of memory and 17 GB of disk on any x86_64 or arm64 machine; GurtOS Personal needs 4 GB and 29 GB.</li>
        <li><strong>Live control:</strong> the portal and the phone app (<a href="https://app.gurtos.com">app.gurtos.com</a>) show every agent on any of your machines, and can approve, undo or pause it, from anywhere with remote access.</li>
        <li><strong>A suite, open source:</strong> the OS in three editions, the companion app, remote access, an app platform for integrations like this one, <a href={LINKS.docs}>the docs</a>, and <a href={LINKS.repo}>the code</a> under Apache-2.0.</li>
      </ul>
    </aside>

    <Criteria sponsor={d.sponsor} source={d.criteriaSource} items={d.criteria} />
    <Shots shots={d.shots} />
    <LinkList links={d.links} />

    <div class="prose">
      <Content components={{ Flow, Status }} />
    </div>

    <nav class="pager" aria-label="More tracks">
      {prev ? <a href={`/tracks/${prev.id}/`} rel="prev">Previous: {prev.data.sponsor}</a> : <a href="/">Back to the overview</a>}
      {next ? <a href={`/tracks/${next.id}/`} rel="next">Next: {next.data.sponsor}</a> : <a href="/#tracks">All tracks</a>}
    </nav>
    <details class="others">
      <summary>Every track</summary>
      <ul>
        {all.map((t) => (
          <li>
            {t.id === entry.id ? <span aria-current="page">{t.data.sponsor}</span> : <a href={`/tracks/${t.id}/`}>{t.data.sponsor}</a>}
          </li>
        ))}
      </ul>
    </details>
  </article>
</Base>

<style>
  .track {
    padding-top: var(--space-5);
    max-width: 64rem;
  }
  .crumbs {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-4) var(--space-7);
    align-items: start;
    margin-bottom: var(--space-5);
  }
  .head > .lead,
  .head > .proof,
  .head > .jumps {
    grid-column: 1 / -1;
  }
  .head .kicker {
    font-family: var(--font-mono);
    color: var(--color-focus);
    letter-spacing: 0.06em;
  }
  .head h1 {
    margin-bottom: var(--space-3);
  }
  .sponsor {
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    font-weight: 500;
    margin: 0;
  }
  .best {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-strong);
  }
  .best p {
    margin: 0;
  }
  .best .label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }
  .best-line {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .pitch {
    margin-top: var(--space-2) !important;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
  .hills {
    display: block;
    width: 100%;
    height: clamp(70px, 12vw, 150px);
    margin: var(--space-4) 0 var(--space-6);
    border-radius: var(--radius-md);
  }
  .runs-on {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    max-width: var(--measure);
    font-size: 0.93rem;
  }
  .runs-h {
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .runs-why {
    margin: 0 0 var(--space-2);
    color: var(--color-text-secondary);
  }
  .runs-on ul {
    margin: 0;
    padding-left: 1.2em;
  }
  .runs-on li {
    margin-bottom: var(--space-1);
  }
  .proof {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-left: 4px solid var(--color-desktop-accent);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: 1.02rem;
  }
  .proof .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-state-waiting-fg);
    margin-right: var(--space-2);
  }
  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0 var(--space-6);
    font-size: 0.92rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    font-weight: 500;
  }
  .others {
    margin-top: var(--space-5);
  }
  .others summary {
    cursor: pointer;
    font-weight: 500;
  }
  .others ul {
    columns: 3 12rem;
    padding-left: 1.2em;
    margin-top: var(--space-3);
  }
  .others li {
    margin-bottom: var(--space-1);
  }
</style>

