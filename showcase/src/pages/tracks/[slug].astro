---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Criteria from '../../components/Criteria.astro';
import VideoSlot from '../../components/VideoSlot.astro';
import Shots from '../../components/Shots.astro';
import LinkList from '../../components/LinkList.astro';
import Flow from '../../components/Flow.astro';
import Status from '../../components/Status.astro';
import RunsOn from '../../components/RunsOn.astro';
import TrackNav from '../../components/TrackNav.astro';
import { kit } from '../../components/kit';
import { LINKS } from '../../data/site';

export async function getStaticPaths() {
  const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);
  return tracks.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: tracks[i - 1], next: tracks[i + 1], all: tracks },
  }));
}

const { entry, prev, next, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const number = String(d.order).padStart(2, '0');
const jumps = [
  ['criteria', 'Criteria'],
  ...(d.shots.length ? [['shots', 'Screenshots']] : []),
  ...(d.links.length ? [['links', 'Live links']] : []),
  ['evidence', 'Evidence'],
  ['how-it-works', 'How it works'],
  ['try-it', 'Try it'],
  ['status', 'Live or test'],
  ['limits', 'Limits'],
];
---

<Base title={`${d.sponsor}: ${d.title} | GurtOS at Cal Hacks 13.0`} description={d.summary}>
  <TrackNav number={number} sponsor={d.sponsor} prev={prev && { id: prev.id, sponsor: prev.data.sponsor }} next={next && { id: next.id, sponsor: next.data.sponsor }} />
  {
    d.design === 'kit' ? (
      <article class="wrap track">
        <header class="khead">
          <p class="kicker">Track {number} · Sponsor track</p>
          <h1>{d.title}</h1>
          <p class="sponsor">{d.sponsor} · {d.prize}</p>
          <p class="kbest">Best shown in <strong>{d.editions}</strong> <span aria-hidden="true">·</span> <a href={LINKS.site}>The product: gurtos.com</a> <span aria-hidden="true">·</span> <a href={LINKS.try}>Try it live: try.gurtos.com</a></p>
        </header>
        <div class="kit" data-track-body>
          <Content components={kit} />
        </div>
        <details class="runs-fold">
          <summary>Runs on top of GurtOS</summary>
          <RunsOn />
        </details>
      </article>
    ) : (
  <article class="wrap track" data-track-body>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">All tracks</a> / {number} / {d.sponsor} <span class="to-product">· The product: <a href={LINKS.site}>gurtos.com</a> · <a href={LINKS.try}>Try it live</a></span></nav>
    <header class="head">
      <div class="head-main">
        <p class="kicker">Track {number} · Sponsor track</p>
        <h1>{d.title}</h1>
        <p class="sponsor">{d.sponsor} · {d.prize}</p>
      </div>
      <div class="best">
        <p class="label">Best shown in</p>
        <p class="best-line">{d.editions}</p>
        <p class="pitch" set:html={d.pitch} />
      </div>
      <p class="lead measure">{d.summary}</p>
      <p class="proof measure"><span class="label">Proof</span> <span set:html={d.proof} /></p>
      <nav class="jumps" aria-label="On this page">
        {jumps.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </header>
    <svg class="hills" viewBox="0 0 1920 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 70C300 0 520 35 760 8C1000 -18 1250 -34 1500 18C1750 70 1800 0 1920 26V200H0Z" fill="var(--gw-hill-1)" />
      <path d="M0 130C260 75 520 115 820 85C1120 50 1300 110 1560 68C1820 26 1820 100 1920 85V200H0Z" fill="var(--gw-hill-2)" />
      <path d="M0 185C300 140 640 172 960 148C1280 124 1500 172 1920 132V200H0Z" fill="var(--gw-hill-3)" />
    </svg>

    <VideoSlot video={d.video ?? entry.id} clip={d.clip} label={`${d.sponsor} video`} />

    <RunsOn />

    <Criteria sponsor={d.sponsor} source={d.criteriaSource} items={d.criteria} />
    <Shots shots={d.shots} />
    <LinkList links={d.links} />

    <div class="prose">
      <Content components={{ Flow, Status }} />
    </div>

  </article>
    )
  }
  <div class="wrap track pager-wrap">
    <nav class="pager" aria-label="More tracks">
      {prev ? <a href={`/tracks/${prev.id}/`} rel="prev">Previous: {prev.data.sponsor}</a> : <a href="/">Back to the tracks list</a>}
      {next ? <a href={`/tracks/${next.id}/`} rel="next">Next: {next.data.sponsor}</a> : <a href="/">All tracks</a>}
    </nav>
    <details class="others">
      <summary>Every track</summary>
      <ul>
        {all.map((t) => (
          <li>
            {t.id === entry.id ? <span aria-current="page">{t.data.sponsor}</span> : <a href={`/tracks/${t.id}/`}>{t.data.sponsor}</a>}
          </li>
        ))}
      </ul>
    </details>
  </div>
</Base>

<style>
  .track {
    padding-top: var(--space-5);
    max-width: 64rem;
  }
  .to-product {
    margin-left: var(--space-3);
    color: var(--color-text-secondary);
  }
  .crumbs {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-4) var(--space-7);
    align-items: start;
    margin-bottom: var(--space-5);
  }
  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
    }
  }
  .head > .lead,
  .head > .proof,
  .head > .jumps {
    grid-column: 1 / -1;
  }
  .head .kicker {
    font-family: var(--font-mono);
    color: var(--color-focus);
    letter-spacing: 0.06em;
  }
  .head h1 {
    margin-bottom: var(--space-3);
  }
  .sponsor {
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    font-weight: 500;
    margin: 0;
  }
  .best {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-strong);
  }
  .best p {
    margin: 0;
  }
  .best .label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }
  .best-line {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .pitch {
    margin-top: var(--space-2) !important;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
  .hills {
    display: block;
    width: 100%;
    height: clamp(70px, 12vw, 150px);
    margin: var(--space-4) 0 var(--space-6);
    border-radius: var(--radius-md);
  }
  .proof {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-left: 4px solid var(--color-desktop-accent);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: 1.02rem;
  }
  .proof .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-state-waiting-fg);
    margin-right: var(--space-2);
  }
  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0 var(--space-6);
    font-size: 0.92rem;
  }
  .khead {
    margin: var(--space-6) 0 var(--space-5);
    max-width: var(--measure);
  }
  .khead .kicker {
    font-family: var(--font-mono);
    color: var(--color-focus);
    letter-spacing: 0.06em;
  }
  .khead h1 {
    margin-bottom: var(--space-3);
  }
  .kbest {
    margin: var(--space-3) 0 0;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }
  .kit > :global(p),
  .kit > :global(ul),
  .kit > :global(ol),
  .kit > :global(h3),
  .kit > :global(blockquote) {
    max-width: var(--measure);
  }
  .kit > :global(h2) {
    margin: var(--space-7) 0 var(--space-3);
  }
  .kit > :global(h3) {
    margin: var(--space-5) 0 var(--space-2);
  }
  .kit > :global(table) {
    display: block;
    overflow-x: auto;
  }
  .runs-fold {
    margin: var(--space-7) 0 0;
    max-width: var(--measure);
  }
  .runs-fold > summary {
    cursor: pointer;
    font-weight: 600;
  }
  .runs-fold :global(.runs-on) {
    margin-top: var(--space-3);
  }
  .pager-wrap {
    padding-bottom: 0;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
    font-weight: 500;
  }
  .others {
    margin-top: var(--space-5);
  }
  .others summary {
    cursor: pointer;
    font-weight: 500;
  }
  .others ul {
    columns: 3 12rem;
    padding-left: 1.2em;
    margin-top: var(--space-3);
  }
  .others li {
    margin-bottom: var(--space-1);
  }
</style>


<style is:global>
  [data-track-body] h2[id],
  .track h2[id] {
    scroll-margin-top: 4.5rem;
  }
</style>
