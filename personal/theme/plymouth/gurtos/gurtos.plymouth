[Plymouth Theme]
Name=GurtOS
Description=The GurtOS wordmark and a spinner on the night sky
ModuleName=two-step

[two-step]
Font=Atkinson Hyperlegible Next 12
TitleFont=Atkinson Hyperlegible Next 16
ImageDir=/usr/share/plymouth/themes/gurtos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.75
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.6
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x27313f
BackgroundEndColor=0x27313f
MessageBelowAnimation=true
