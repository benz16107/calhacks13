# GurtOS defaults for every account (docs/figma/personal-os/README.md). People can change all of these; nothing
# here is locked: the part that must stay on (the GurtOS Shell extension) is held by the GurtOS session mode.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/gurtos/hills-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/gurtos/hills-dark.svg'
picture-options='zoom'
primary-color='#DCE5ED'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/gurtos/hills-dark.svg'
primary-color='#27313F'

[org/gnome/desktop/interface]
gtk-theme='Yaru-blue'
icon-theme='GurtOS'
cursor-theme='Bibata-Modern-Classic'
font-name='Atkinson Hyperlegible Next 11'
document-font-name='Atkinson Hyperlegible Next 11'
monospace-font-name='Atkinson Hyperlegible Mono 11'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/shell]
# Listed here too so it keeps running on the lock screen (the GurtOS session mode loads it either way).
enabled-extensions=['gurtos@gurtos.dev']
favorite-apps=['firefox_firefox.desktop', 'org.gnome.Epiphany.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Console.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Software.desktop', 'dev.box.Box.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
# Ubuntu's dock as the GurtOS dock: floating at the bottom, dark glass, 48 px icons, hides when a window touches it
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
transparency-mode='FIXED'
background-opacity=0.86
custom-background-color=true
background-color='#1E2228'
dash-max-icon-size=48
show-mounts=false
show-trash=false
show-apps-at-top=false
running-indicator-style='DOTS'
custom-theme-shrink=true
# The top bar counts what needs you; a second count on the dock icon only disagreed with it (I-4).
show-icons-notifications-counter=false

# Talk to your computer: Super+Alt+Space listens (the same press again ends the sentence early).
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gurtos-voice/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gurtos-voice]
name='Talk to your computer'
command='/opt/box/personal/voice.py'
binding='<Super><Alt>space'

# Activities search: GurtOS's tasks and Find first, then Files and the rest.
[org/gnome/desktop/search-providers]
sort-order=['dev.box.Box.desktop', 'dev.box.Find.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop', 'org.gnome.Calculator.desktop']
