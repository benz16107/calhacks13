[Icon Theme]
Name=GurtOS
Comment=GurtOS icons: Papirus (GPL-3.0) with folders in GurtOS slate, then Adwaita for symbolic icons
Inherits=Papirus,Adwaita,hicolor
Directories=scalable/actions,scalable/places

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places
