# Box first in the dock, for new accounts. Anyone who already arranged their dock keeps it.
[org.gnome.shell]
favorite-apps = [ 'dev.box.Box.desktop', 'firefox_firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Terminal.desktop', 'snap-store_snap-store.desktop', 'yelp.desktop' ]

[org.gnome.shell:ubuntu]
favorite-apps = [ 'dev.box.Box.desktop', 'firefox_firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Terminal.desktop', 'snap-store_snap-store.desktop', 'yelp.desktop' ]
