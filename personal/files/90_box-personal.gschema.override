# GurtOS first in the dock, for new accounts. Anyone who already arranged their dock keeps it. The dock skips entries
# that are not installed: GurtOS Personal's browser is GNOME Web; on a plain Ubuntu install it is the Firefox snap.
[org.gnome.shell]
favorite-apps = [ 'dev.box.Box.desktop', 'org.gnome.Epiphany.desktop', 'firefox_firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Terminal.desktop', 'yelp.desktop' ]

[org.gnome.shell:ubuntu]
favorite-apps = [ 'dev.box.Box.desktop', 'org.gnome.Epiphany.desktop', 'firefox_firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Terminal.desktop', 'yelp.desktop' ]
