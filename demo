#!/usr/bin/env bash
# The merge gate: runs the four demo moments, with no screen, on a test VM. Exit 0 = pass.
#   ./demo                         the machine named default there, or BOX_SHELL
#   ./demo <name>                  a test machine named in ~/.config/gurtos/machines (name=shell command)
#   BOX_SHELL='ssh my-vm' ./demo   any test machine with passwordless sudo
#   ./demo --here                  this machine. Only on a test VM: it needs root.
#   ./demo --live-droid            also run the real Droid steps. They spend Factory credit, so they are OFF by default
#                                  (same as DEMO_LIVE=droid). The run prints Factory's 5-hour and weekly use first.
#   DEMO_LIVE=apify,visa ./demo    also make these tracks' paid or slow live calls (off by default)
#   DEMO_ONLY=apify ./demo         only that track's step, for a developer's loop (the merge gate runs everything)
#   BOX_REVIEW=off ./demo          switch the second look at risky agent steps off (the anthropic track compares)
set -euo pipefail
cd "$(dirname "$0")"
skip=; args=()
for a in "$@"; do
  case $a in
    --live-droid) export DEMO_LIVE="${DEMO_LIVE:+$DEMO_LIVE,}droid" ;;
    --skip-droid) ;; # real Droid is off by default now; kept so old command lines still work
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

if [[ ${1:-} == --here ]]; then
  [[ $(id -u) == 0 ]] || exec sudo DEMO_SKIP_DROID="${DEMO_SKIP_DROID:-$skip}" DEMO_LIVE="${DEMO_LIVE:-}" DEMO_ONLY="${DEMO_ONLY:-}" BOX_REVIEW="${BOX_REVIEW:-}" "$0" --here
  flock /run/lock/box-setup.lock core/setup.sh >/dev/null # runs side by side share one machine setup
  lock=$(sha256sum package-lock.json | cut -c1-16)
  if [[ -f node_modules/.lock-$lock ]]; then
    # root deps are warm; restore any per-track node_modules the ship wiped (a no-op when nothing is missing)
    npm install --prefer-offline --no-audit --no-fund --no-update-notifier --loglevel=error
  else
    npm ci --no-audit --no-fund --no-update-notifier --loglevel=error && touch "node_modules/.lock-$lock"
  fi
  # One gate run at a time per machine: runs side by side fail on timeouts, not on the code. A second run waits.
  exec 7>/run/lock/box-demo-run.lock
  if ! flock -n 7; then
    echo "demo: another demo run is using this machine; waiting for it to finish"
    flock 7
  fi
  BOX_REVIEW="${BOX_REVIEW:-}" DEMO_ONLY="${DEMO_ONLY:-}" DEMO_SKIP_DROID="${DEMO_SKIP_DROID:-$skip}" exec node --experimental-strip-types --disable-warning=ExperimentalWarning core/demo.ts
fi

# Named machines come from an untracked file, one "name=command that runs a root shell there" per line.
machines=${GURTOS_MACHINES:-$HOME/.config/gurtos/machines}
machine() { [[ -f $machines ]] && sed -n "s/^$1=//p" "$machines" | head -1; }
if [[ -n ${1:-} ]]; then
  BOX_SHELL=$(machine "$1")
  [[ -n $BOX_SHELL ]] || { echo "demo: no machine named \"$1\" in $machines (lines like: myvm=ssh root@myvm)" >&2; exit 2; }
elif [[ -z ${BOX_SHELL:-} ]]; then
  BOX_SHELL=$(machine default)
  [[ -n $BOX_SHELL ]] || { echo "usage: ./demo <machine> | BOX_SHELL='ssh root@vm' ./demo | ./demo --here (on an Ubuntu 24.04 test VM). Machines live in $machines." >&2; exit 2; }
fi

# Ship this checkout (tracked and new files, not ignored ones) and run it there. node_modules stays between runs.
dest=/opt/box-dev/$(basename "$PWD")
echo "demo: $BOX_SHELL, in $dest"
{
  # Runs from different checkouts go side by side. A second run from the same checkout waits for the first.
  echo "set -e; mkdir -p $dest; exec 9>$dest.lock"
  echo "flock -n 9 || { echo 'demo: waiting for another run from this checkout'; flock 9; }"
  echo "find $dest -mindepth 1 -maxdepth 1 ! -name node_modules -exec rm -rf {} +"
  echo "base64 -d <<'EOF' | tar -xzf - -C $dest"
  git ls-files -co --exclude-standard | while IFS= read -r f; do [[ -e $f ]] && printf '%s\n' "$f"; done |
    tar --mode=go+rX,go-w -czf - -T - | base64
  echo EOF
  echo "DEMO_SKIP_DROID=$skip DEMO_LIVE=$(printf %q "${DEMO_LIVE:-}") DEMO_ONLY=$(printf %q "${DEMO_ONLY:-}") BOX_REVIEW=$(printf %q "${BOX_REVIEW:-}") exec $dest/demo --here"
} | $BOX_SHELL sudo bash -s || { code=$?; [[ $code == 255 ]] && echo "demo: could not reach the test machine ($BOX_SHELL)" >&2; exit $code; }
