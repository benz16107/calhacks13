#!/usr/bin/env bash
# The merge gate: runs the four demo moments, with no screen, on a test VM. Exit 0 = pass.
#   ./demo                         the linuxbox VM if it is running, else the laptop VM
#   ./demo laptop|linuxbox|vultr   that test machine
#   BOX_SHELL='ssh my-vm' ./demo   any test machine with passwordless sudo
#   ./demo --here                  this machine. Only on a test VM: it needs root.
#   --skip-droid                   skip the real Droid step, only when Factory itself is down
set -euo pipefail
cd "$(dirname "$0")"
skip=; args=()
for a in "$@"; do if [[ $a == --skip-droid ]]; then skip=1; else args+=("$a"); fi; done
set -- "${args[@]+"${args[@]}"}"

if [[ ${1:-} == --here ]]; then
  [[ $(id -u) == 0 ]] || exec sudo DEMO_SKIP_DROID="${DEMO_SKIP_DROID:-$skip}" "$0" --here
  core/setup.sh >/dev/null
  lock=$(sha256sum package-lock.json | cut -c1-16)
  if [[ ! -f node_modules/.lock-$lock ]]; then
    npm ci --omit=dev --no-audit --no-fund --no-update-notifier --loglevel=error && touch "node_modules/.lock-$lock"
  fi
  DEMO_SKIP_DROID="${DEMO_SKIP_DROID:-$skip}" exec node --experimental-strip-types --disable-warning=ExperimentalWarning core/demo.ts
fi

lima=$(command -v limactl || echo /home/linuxbrew/.linuxbrew/bin/limactl)
on() { [[ $(hostname -s) == "$1"* ]]; }
laptop="/opt/homebrew/bin/limactl shell --workdir / box --"
on benmac || laptop="ssh -o ConnectTimeout=10 benmac $laptop"
linuxbox="/home/linuxbrew/.linuxbrew/bin/limactl shell --workdir / box --"
on linuxbox || linuxbox="ssh -o ConnectTimeout=10 linuxbox $linuxbox"
case ${1:-} in
  laptop) BOX_SHELL=$laptop ;;
  linuxbox) BOX_SHELL=$linuxbox ;;
  vultr) BOX_SHELL="ssh -o ConnectTimeout=10 vultrbox" ;;
  '')
    if [[ -z ${BOX_SHELL:-} ]]; then
      if on linuxbox && "$lima" list box 2>/dev/null | grep -q Running; then BOX_SHELL=$linuxbox; else BOX_SHELL=$laptop; fi
    fi ;;
  *) echo "usage: ./demo [laptop|linuxbox|vultr|--here]" >&2; exit 2 ;;
esac

# Ship this checkout (tracked and new files, not ignored ones) and run it there. node_modules stays between runs.
dest=/opt/box-dev/$(basename "$PWD")
echo "demo: $BOX_SHELL, in $dest"
{
  echo "set -e; mkdir -p $dest; find $dest -mindepth 1 -maxdepth 1 ! -name node_modules -exec rm -rf {} +"
  echo "base64 -d <<'EOF' | tar -xzf - -C $dest"
  git ls-files -co --exclude-standard | while IFS= read -r f; do [[ -e $f ]] && printf '%s\n' "$f"; done |
    tar -czf - -T - | base64
  echo EOF
  echo "DEMO_SKIP_DROID=$skip exec $dest/demo --here"
} | $BOX_SHELL sudo bash -s
