---
import { Image } from 'astro:assets';
import Landing from '../layouts/Landing.astro';
import PhoneFrame from '../theme/PhoneFrame.astro';
import WatchFrame from '../theme/WatchFrame.astro';
import DisplayFrame from '../theme/DisplayFrame.astro';
import { NAME, REPO, LICENSE_NAME } from '../product.ts';
import server from '../assets/home/server-screen.png';
import personal from '../assets/home/personal-everyday.png';
import personalDark from '../assets/home/personal-everyday-dark.png';
import businessDesktop from '../assets/home/business-desktop.png';
import businessPhone from '../assets/home/business-phone.png';
import homeLight from '../assets/home/iphone-home-light.png';
import homeDark from '../assets/home/iphone-home-dark.png';
import approvalLight from '../assets/home/iphone-approval-light.png';
import approvalDark from '../assets/home/iphone-approval-dark.png';
import watch from '../assets/home/watch-small.png';
import poster from '../assets/home/video-poster.jpg';

const RELEASE = `${REPO}/releases/download/v0.2.0-preview`;
const isos = (edition: string) => [
  { arch: 'x86_64', label: 'Intel or AMD (x86_64)', file: `gurtos-${edition}-x86_64.iso` },
  { arch: 'arm64', label: 'Apple silicon (arm64)', file: `gurtos-${edition}-arm64.iso` },
];
const VIDEO = 'https://youtu.be/rREjU2ddIyo';
const core = [
  { label: 'Undo one task', line: 'Each task writes to its own layer over your files. Undo drops that layer and keeps every other task\'s work.', href: '/docs/concepts/workspaces-and-layers/' },
  { label: 'Keys stay out of reach', line: 'Keys live in a root-only vault. The box makes keyed calls for the agent, so a poisoned web page has nothing to steal.', href: '/docs/concepts/vault-and-broker/' },
  { label: 'Only the hosts you allow', line: 'A task\'s network reaches the box\'s proxy and nothing else. The proxy lets through the hosts that task lists.', href: '/docs/concepts/network-policy/' },
  { label: 'Pause for your OK', line: 'Spending over the budget or your threshold stops and asks, on the screen or your phone. Other tasks keep running.', href: '/docs/concepts/approvals-and-budgets/' },
  { label: 'Pull the plug', line: 'After a power cut, the box rebuilds every task from its log and carries on where it stopped.', href: '/docs/concepts/resume-after-power-loss/' },
  { label: 'Every step logged', line: 'One append-only action log of each step, tool call, approval, cost and blocked connection.', href: '/docs/concepts/action-log/' },
];
---

<Landing title={NAME} description={`${NAME}: operating systems built for AI agents, on Ubuntu 24.04. Each agent task runs as its own Linux user on its own copy of your files, never holds your keys, and asks before it spends. Download GurtOS Server or GurtOS Personal.`}>
  <div class="wrap">
    <section class="intro" aria-labelledby="home-h">
      <div class="intro-text">
        <h1 id="home-h">Operating systems built for AI agents</h1>
        <p class="lead">Each agent task runs as its own Linux user, on its own copy of your files. It never holds your keys, it asks before it spends, and you can undo it without touching any other task.</p>
        <p class="actions">
          <a class="btn primary" href="/download/">Download {NAME}</a>
          <a class="btn" href="/docs/">Read the docs</a>
        </p>
        <p class="status">Preview release v0.2.0-preview, built on Ubuntu 24.04. It has not had a security audit, so use a spare computer or a virtual machine.</p>
      </div>
      <figure class="video">
        <a href={VIDEO} aria-label="Watch the 3-minute GurtOS video on YouTube">
          <Image src={poster} widths={[640, 960, 1280]} sizes="(min-width: 900px) 40vw, 100vw" alt="" loading="eager" fetchpriority="high" />
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
        </a>
        <figcaption><a href={VIDEO}>Watch the 3-minute video</a> on YouTube: a task stops for an OK, a booby-trapped page is stopped, one task is undone and the power is pulled.</figcaption>
      </figure>
    </section>
  </div>

  <svg class="hills" viewBox="0 0 1920 260" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 80C300 0 520 40 760 10C1000 -20 1250 -40 1500 20C1750 80 1800 0 1920 30V260H0Z" fill="var(--gw-hill-1)" />
    <path d="M0 160C260 90 520 140 820 100C1120 60 1300 130 1560 80C1820 30 1820 120 1920 100V260H0Z" fill="var(--gw-hill-2)" />
    <path d="M0 230C300 170 640 210 960 180C1280 150 1500 210 1920 160V260H0Z" fill="var(--gw-hill-3)" />
  </svg>

  <div class="wrap">
    <section id="editions" aria-labelledby="editions-h">
      <h2 id="editions-h" class="section-h">One core, three editions</h2>

      <article class="edition" id="server">
        <figure class="media rig">
          <div class="desk"><DisplayFrame src={server} alt="The GurtOS Server box screen: what needs you, what is running, what was spent today, and a dock of the system apps." /></div>
          <div class="phone"><PhoneFrame src={homeLight} dark={homeDark} alt="The GurtOS iPhone app: three requests under Needs you, each with Deny and Approve." /></div>
        </figure>
        <div class="text">
          <h3><span class="dot server" aria-hidden="true"></span>{NAME} Server</h3>
          <p>An always-on agent box with nothing else on it.</p>
          <p class="facts"><a href="/docs/get-started/install-server/#why-it-is-light">No desktop · 1.37 GB disc · a task runs in 1 GB of RAM</a></p>
          <p class="dl-label">Download</p>
          <div class="dl">
            {isos('server').map((f) => <a class="btn" href={`${RELEASE}/${f.file}`} data-arch={f.arch}>{f.label}</a>)}
          </div>
        </div>
      </article>

      <article class="edition" id="personal">
        <figure class="media rig">
          <div class="desk"><DisplayFrame src={personal} dark={personalDark} alt="GurtOS Personal in everyday use: mail, a browser and Files open, while the GurtOS app and a notification ask to approve a $42.10 grocery order." /></div>
          <div class="phone"><PhoneFrame src={approvalLight} dark={approvalDark} alt="A request on the iPhone: Buy a GPU hour, $8, with Deny and Approve $8." /></div>
          <div class="watch"><WatchFrame src={watch} alt="The GurtOS Apple Watch app: Buy a GPU hour, $8, with a red deny and a green approve button." /></div>
        </figure>
        <div class="text">
          <h3><span class="dot personal" aria-hidden="true"></span>{NAME} Personal</h3>
          <p>Your own laptop, with agents working beside you.</p>
          <p class="facts"><a href="/docs/get-started/install-personal/">Ubuntu's GNOME desktop · your folders change only when you choose Keep</a></p>
          <p class="dl-label">Download</p>
          <div class="dl">
            {isos('personal').map((f) => <a class="btn" href={`${RELEASE}/${f.file}`} data-arch={f.arch}>{f.label}</a>)}
          </div>
        </div>
      </article>

      <article class="edition" id="business">
        <figure class="media rig">
          <div class="desk"><DisplayFrame src={businessDesktop} alt="GurtOS Business: a $40,000 credit line Sam asked for waits for Rosa, the Controller, on her desktop." /></div>
          <div class="phone"><PhoneFrame src={businessPhone} inset edge="#edebe6" alt="The same $40,000 credit line on Rosa's phone, with Deny and Approve $40,000." /></div>
        </figure>
        <div class="text">
          <h3><span class="dot business" aria-hidden="true"></span>{NAME} Business</h3>
          <p>A team's shared box, turned on from Server or Personal.</p>
          <p class="facts"><a href="/docs/guides/turn-on-business/">Preview · roles · approvals routed by a policy in plain words · audit trail</a></p>
          <div class="dl"><a class="btn" href="/docs/guides/turn-on-business/">Turn on Business</a></div>
        </div>
      </article>
      <p class="more"><a href="/download/">Checksums, signatures and install steps</a></p>
    </section>

    <section aria-labelledby="core-h">
      <h2 id="core-h" class="section-h">What the core does</h2>
      <ul class="core">
        {core.map((c) => <li><a href={c.href}>{c.label}</a> {c.line}</li>)}
      </ul>
    </section>

    <p class="closing">Open source under the <a href={REPO}>{LICENSE_NAME}</a> on GitHub.</p>
  </div>
</Landing>

<script>
  // Mark the download that matches this computer. A Mac is assumed to be Apple silicon, because Intel Macs
  // cannot run an arm64 VM and the user agent does not say which Mac it is. No cookies, nothing is sent.
  const ua = navigator.userAgent;
  const arm = /Macintosh|Mac OS X/.test(ua) || /aarch64|arm64|\barm\b/i.test(ua);
  const want = arm ? 'arm64' : 'x86_64';
  document.querySelectorAll<HTMLAnchorElement>('.dl .btn[data-arch]').forEach((a) => {
    if (a.dataset.arch === want) a.classList.add('primary');
  });
</script>

<style>
  .intro { padding: 4rem 0 3rem; display: grid; gap: 2.5rem; align-items: center; }
  .intro h1 { margin-bottom: 1rem; }
  .lead { font-size: var(--gw-text-lg); color: var(--gw-ink-2); max-width: 40rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .actions .btn.primary { font-size: 1.1rem; padding: 0.8rem 1.4rem; }
  .actions .btn { padding: 0.8rem 1.4rem; }
  .status { margin-top: 1.5rem; font-size: var(--gw-text-sm); color: var(--gw-ink-2); max-width: 40rem; }
  .video { margin: 0; }
  .video > a { position: relative; display: block; }
  .video img { width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--gw-rule); border-radius: var(--gw-radius); }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--gw-action); color: var(--gw-on-action); }
  .video > a:focus-visible { outline-offset: 4px; }
  .video figcaption { margin-top: 0.75rem; font-size: var(--gw-text-sm); color: var(--gw-ink-2); }
  @media (min-width: 900px) { .intro { grid-template-columns: 7fr 5fr; } }
  .hills { display: block; width: 100%; height: clamp(70px, 11vw, 170px); }
  .section-h { font-size: var(--gw-h2); }
  .edition { display: grid; gap: 1.5rem 3rem; padding: 2rem 0; border-top: 1px solid var(--gw-rule); align-items: center; }
  .media { margin: 0; }
  /* Devices overlap a little: the phone covers only the display's right bezel and edge, and the watch only the
     phone's right edge beside an empty part of its screen. Sizes are shares of the figure, so every row is the same. */
  .rig { position: relative; container-type: inline-size; }
  .rig .desk { width: 75cqw; margin-bottom: 5cqw; }
  .rig .phone { position: absolute; left: 72.8cqw; bottom: 0; width: 17cqw; }
  .rig .watch { position: absolute; left: 88.6cqw; top: 33.4cqw; width: 11cqw; }
  @media (max-width: 639px) {
    .rig { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; }
    .rig .desk { width: 100cqw; margin-bottom: 4cqw; }
    .rig .phone { position: static; width: 36cqw; }
    .rig .watch { position: static; width: 24cqw; margin: 35cqw 0 0 -2.5cqw; }
  }
  /* Two equal buttons side by side, or stacked at the same width where the column is narrow. */
  .text { container-type: inline-size; }
  .text p.dl-label { margin: 1.1rem 0 0.4rem; font-size: var(--gw-text-sm); color: var(--gw-ink-2); }
  .dl { display: grid; grid-template-columns: repeat(2, 11.5rem); gap: 0.5rem; margin-top: 1.1rem; }
  .dl-label + .dl { margin-top: 0; }
  .dl .btn { padding: 0.5rem 0.8rem; font-size: 0.9rem; text-align: center; white-space: nowrap; }
  @container (max-width: 23.6rem) { .dl { grid-template-columns: 11.5rem; } }
  .text h3 { font-size: var(--gw-h3); display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem; }
  .text p { font-size: var(--gw-text-lg); color: var(--gw-ink-2); }
  .text p.facts { margin-top: -0.4rem; font-size: var(--gw-text-sm); }
  .facts a { color: var(--gw-ink-2); }
  .dot { width: 0.8rem; height: 0.8rem; border-radius: 2px; flex: none; }
  .dot.server { background: #46586b; outline: 1px solid var(--gw-rule-strong); }
  .dot.personal { background: var(--gw-amber); }
  .dot.business { background: var(--gw-link); }
  .more { margin-top: 0.5rem; font-size: var(--gw-text-sm); }
  .core { list-style: none; padding: 0; margin: 0; color: var(--gw-ink-2); }
  .core li { padding: 0.8rem 0; border-top: 1px solid var(--gw-rule); }
  .core a { font-weight: 700; color: var(--gw-ink); margin-right: 0.4rem; }
  .closing { margin-top: 3rem; color: var(--gw-ink-2); }
  @media (min-width: 900px) {
    .edition { grid-template-columns: 8fr 4fr; }
    .core { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; }
  }
</style>
