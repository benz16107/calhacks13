---
import { Image } from 'astro:assets';
import Landing from '../layouts/Landing.astro';
import HeroLayers from '../components/HeroLayers.astro';
import { NAME, REPO, LICENSE_NAME } from '../product.ts';
import server from '../assets/home/server-screen.png';
import personal from '../assets/home/personal-everyday.png';
import businessDesktop from '../assets/home/business-desktop.png';
import businessPhone from '../assets/home/business-phone.png';

const RELEASE = `${REPO}/releases/download/v0.1.0-preview`;
const isos = (edition: string) => [
  { arch: 'x86_64', label: 'x86_64', file: `gurtos-${edition}-x86_64.iso` },
  { arch: 'arm64', label: 'arm64, Apple silicon', file: `gurtos-${edition}-arm64.iso` },
];
const core = [
  { label: 'Undo one task', line: 'Each task works on its own layer.', href: '/docs/concepts/workspaces-and-layers/' },
  { label: 'Keys stay out of reach', line: 'Tasks never hold a secret.', href: '/docs/concepts/vault-and-broker/' },
  { label: 'Pause for your OK', line: 'Spending waits for you.', href: '/docs/concepts/approvals-and-budgets/' },
  { label: 'Every step logged', line: 'One action log, kept on disk.', href: '/docs/concepts/action-log/' },
];
---

<Landing title={NAME} description={`${NAME} is an operating system where AI agents do real work with real access and never hold your keys. Download GurtOS Server or GurtOS Personal.`}>
  <section class="hero" aria-labelledby="home-h">
    <div class="wrap hero-grid">
      <div class="intro">
        <h1 id="home-h">An operating system where AI agents work safely</h1>
        <p class="lead">Agents never hold your keys. Each task runs on its own copy of your files.</p>
        <p class="actions">
          <a class="btn primary" href="/download/">Download {NAME}</a>
          <a class="btn" href="/docs/">Docs</a>
        </p>
      </div>
      <HeroLayers />
    </div>
  </section>

  <div class="wrap">
    <section id="editions" aria-labelledby="editions-h">
      <h2 id="editions-h" class="section-h">One core, three editions</h2>

      <article class="edition" id="server">
        <figure class="media">
          <Image src={server} alt="The GurtOS Server box screen: what needs you, what is running, what was spent today, and a dock of apps." widths={[720, 1440]} sizes="(max-width: 900px) 100vw, 640px" />
        </figure>
        <div class="text">
          <h3><span class="dot server" aria-hidden="true"></span>{NAME} Server</h3>
          <p>An always-on agent box, at home or in the cloud.</p>
          <div class="dl">
            {isos('server').map((f) => <a class="btn" href={`${RELEASE}/${f.file}`} data-arch={f.arch}>Download {f.label}</a>)}
          </div>
        </div>
      </article>

      <article class="edition" id="personal">
        <figure class="media">
          <Image src={personal} alt="GurtOS Personal in everyday use: mail, a browser and Files open, while the GurtOS app and a notification ask to approve a $42.10 grocery order." widths={[720, 1440]} sizes="(max-width: 900px) 100vw, 640px" />
        </figure>
        <div class="text">
          <h3><span class="dot personal" aria-hidden="true"></span>{NAME} Personal</h3>
          <p>Your own laptop, with agents working beside you.</p>
          <div class="dl">
            {isos('personal').map((f) => <a class="btn" href={`${RELEASE}/${f.file}`} data-arch={f.arch}>Download {f.label}</a>)}
          </div>
        </div>
      </article>

      <article class="edition" id="business">
        <figure class="media duo">
          <Image class="desk" src={businessDesktop} alt="GurtOS Business: a $40,000 credit line Sam asked for waits for Rosa, the Controller, on her desktop." widths={[720, 1440]} sizes="(max-width: 900px) 100vw, 640px" />
          <Image class="phone" src={businessPhone} alt="The same $40,000 credit line on Rosa's phone, with Deny and Approve $40,000." widths={[180, 360]} sizes="(max-width: 900px) 25vw, 150px" />
        </figure>
        <div class="text">
          <h3><span class="dot business" aria-hidden="true"></span>{NAME} Business</h3>
          <p>A team's shared box, turned on from Server or Personal.</p>
          <div class="dl"><a class="btn" href="/docs/guides/turn-on-business/">Turn on Business</a></div>
        </div>
      </article>
      <p class="more"><a href="/download/">Checksums, signatures and install steps</a></p>
    </section>

    <section aria-labelledby="core-h">
      <h2 id="core-h" class="section-h">What the core does</h2>
      <ul class="core">
        {core.map((c) => <li><a href={c.href}>{c.label}</a> {c.line}</li>)}
      </ul>
    </section>

    <p class="closing">Open source under the <a href={REPO}>{LICENSE_NAME}</a> on GitHub.</p>
  </div>
</Landing>

<script>
  // Mark the download that matches this computer. A Mac is assumed to be Apple silicon, because Intel Macs
  // cannot run an arm64 VM and the user agent does not say which Mac it is. No cookies, nothing is sent.
  const ua = navigator.userAgent;
  const arm = /Macintosh|Mac OS X/.test(ua) || /aarch64|arm64|\barm\b/i.test(ua);
  const want = arm ? 'arm64' : 'x86_64';
  document.querySelectorAll<HTMLAnchorElement>('.dl .btn[data-arch]').forEach((a) => {
    if (a.dataset.arch === want) a.classList.add('primary');
  });
</script>

<style>
  .hero { overflow: hidden; margin-bottom: 1rem; }
  .hero-grid { display: grid; gap: 2rem; padding: 3.5rem 0 4.5rem; align-items: center; }
  .intro h1 { margin-bottom: 1rem; max-width: 20ch; }
  .lead { font-size: var(--gw-text-lg); color: var(--gw-ink-2); max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .btn.primary { font-size: 1.1rem; padding: 0.8rem 1.4rem; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 5fr 7fr; } }
  .section-h { font-size: var(--gw-h2); }
  .edition { display: grid; gap: 1.5rem 3rem; padding: 2rem 0; border-top: 1px solid var(--gw-rule); align-items: center; }
  .media { margin: 0; }
  .media img { width: 100%; border: 1px solid var(--gw-rule); border-radius: 6px; }
  .duo { position: relative; padding-bottom: 2.5rem; padding-right: 3rem; }
  .duo .phone { position: absolute; right: 0; bottom: 0; width: 24%; border-width: 2px; background: var(--gw-glass); }
  .text h3 { font-size: var(--gw-h3); display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem; }
  .text p { font-size: var(--gw-text-lg); color: var(--gw-ink-2); }
  .dot { width: 0.8rem; height: 0.8rem; border-radius: 2px; flex: none; }
  .dot.server { background: #46586b; outline: 1px solid var(--gw-rule-strong); }
  .dot.personal { background: var(--gw-amber); }
  .dot.business { background: var(--gw-link); }
  .dl { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; }
  .more { margin-top: 0.5rem; font-size: var(--gw-text-sm); }
  .core { list-style: none; padding: 0; margin: 0; color: var(--gw-ink-2); }
  .core li { padding: 0.8rem 0; border-top: 1px solid var(--gw-rule); }
  .core a { font-weight: 700; color: var(--gw-ink); margin-right: 0.4rem; }
  .closing { margin-top: 3rem; color: var(--gw-ink-2); }
  @media (min-width: 900px) {
    .edition { grid-template-columns: 7fr 5fr; }
    .core { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; }
  }
</style>
