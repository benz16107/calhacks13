---
import Landing from '../layouts/Landing.astro';
import { NAME, REPO } from '../product.ts';

const RELEASE = `${REPO}/releases/download/v0.2.0-preview`;
// The Mac and Android apps were not rebuilt for v0.2.0-preview.
const NATIVE = `${REPO}/releases/download/v0.1.0-preview`;
const SUMS: Record<string, string> = {
  'gurtos-server-x86_64.iso': '1879b64bade0589e1b85764f4d1c27ca3348305ccb8ff6245ebd2848640d4eb6',
  'gurtos-server-arm64.iso': 'ff259fc3a5f2fdd7feea11df25081dc9ae4de071baab32e2929200f298322635',
  'gurtos-personal-x86_64.iso': '5d6f3c588df596ca70d8317eee8bc0a4b73b900a5971df0fb87639a2c9018b39',
  'gurtos-personal-arm64.iso': 'e1f34a7716a067bf986d43bf833b1788092222c4b41ac8be20337ad3bf0ce40f',
};
const editions = [
  { id: 'server', name: `${NAME} Server`, size: { x86_64: '1.37 GB', arm64: '1.36 GB' } },
  { id: 'personal', name: `${NAME} Personal`, size: { x86_64: '2.00 GB', arm64: '1.99 GB' } },
] as const;
const archs = [
  { id: 'x86_64', name: 'x86_64', note: 'Intel or AMD PC, server or cloud VM' },
  { id: 'arm64', name: 'arm64', note: 'Apple silicon Mac in UTM or Parallels, or an arm64 server' },
] as const;
const file = (e: string, a: string) => `gurtos-${e}-${a}.iso`;
const url = (e: string, a: string) => `${RELEASE}/${file(e, a)}`;
---

<Landing title="Download GurtOS" description="Download GurtOS v0.2.0-preview, the signed install images for GurtOS Server and GurtOS Personal, with checksums, minimum hardware and install steps." prose={false}>
  <div class="wrap dl-page">
    <section class="top" aria-labelledby="dl-h">
      <h1 id="dl-h">Download {NAME} v0.2.0-preview</h1>
      <p class="lead">Signed install images, built on Ubuntu 24.04. This is a preview that has not had a security audit. Use a spare computer or a virtual machine, because the installer erases the disk it installs to.</p>

      <div class="big">
        {editions.map((e) => (
          <a class="pick" href={url(e.id, 'x86_64')} data-edition={e.id}>
            <span class="pick-name">{e.name}</span>
            <span class="pick-meta"><span class="pick-arch">x86_64</span> · <span class="pick-size">{e.size.x86_64}</span></span>
          </a>
        ))}
      </div>
      <p class="detected" id="detected">Showing x86_64, for an Intel or AMD computer. Other options are below.</p>
    </section>

    <section aria-labelledby="all-h">
      <h2 id="all-h">All downloads</h2>
      <div class="table-wrap">
        <table class="chooser">
          <thead>
            <tr>
              <th scope="col"><span class="sr">Edition</span></th>
              {archs.map((a) => <th scope="col">{a.name}<span class="hint">{a.note}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {editions.map((e) => (
              <tr>
                <th scope="row">{e.name}</th>
                {archs.map((a) => (
                  <td><a class="btn" href={url(e.id, a.id)}>Download <span class="size">{e.size[a.id]}</span></a></td>
                ))}
              </tr>
            ))}
            <tr>
              <th scope="row">{NAME} Business</th>
              <td colspan="2">Turn it on from Server or Personal. <a href="/docs/guides/turn-on-business/">How</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="apps-h">
      <h2 id="apps-h">Approve from your phone or another computer</h2>
      <p class="apps-lead">Each phone or computer pairs with your box using a code from the box's screen. On your home network it reaches the box at the box's own address. Away from home, use a private network such as Tailscale, or a relay you run. <a href="/docs/guides/reach-your-box-from-anywhere/">How to reach your box from anywhere</a>.</p>
      <dl class="apps">
        <div>
          <dt>Any phone or computer</dt>
          <dd>
            <p>No install. Scan the pairing QR code on the box's screen with the phone's camera, or open the box's address in a browser on the same network. The box serves the GurtOS app itself. <a href="/docs/guides/approve-from-your-phone/">Approve from your phone</a> walks through it.</p>
          </dd>
        </div>
        <div>
          <dt>iPhone and Apple Watch</dt>
          <dd>
            <p><strong>iPhone app: TestFlight, internal testing only.</strong> The native app, with Face ID when an approval spends money, a widget, and the Apple Watch app, which installs with it. It is not open to the public yet. <a href={`${REPO}/issues/new?title=TestFlight`}>Open an issue on GitHub</a> titled "TestFlight" to hear when it opens.</p>
          </dd>
        </div>
        <div>
          <dt>Mac</dt>
          <dd>
            <a class="btn" href={`${NATIVE}/gurtos-mac-0.1.0.dmg`}>Download the DMG <span class="size">1.3 MB</span></a>
            <p>A menu bar app for macOS 26 or later, with Approve by Touch ID, ⌥⌘G to ask your computer for a task, and Send to GurtOS in the Share menu. Open the DMG, drag GurtOS to Applications and open it. Choose Add a computer, then paste the box's pairing link or type its address and code. It is signed and notarized by Apple, and it has no auto-update yet. <a href={`${NATIVE}/gurtos-mac-0.1.0.dmg.sha256`}>SHA-256</a>: <code>ef8a7e72441b10dc3d6bacd1308d670cb551ffd8644403429b57e1d733ae994b</code></p>
          </dd>
        </div>
        <div>
          <dt>Android and Windows</dt>
          <dd>
            <p>Use the browser, as above. The Android app in the v0.1.0-preview release, and installing app.gurtos.com, reach a box only through a relay, and the hosted one is not running during the preview. The Android app cannot pair over plain HTTP on a home network.</p>
          </dd>
        </div>
      </dl>
      <p class="caveat">Push notifications need a relay. Without one, a request shows when the app is open.</p>
    </section>

    <section aria-label="Details" class="details">
      <details id="verify-it">
        <summary>Verify the download</summary>
        <p>Put the ISO, <a href={`${RELEASE}/SHA256SUMS`}>SHA256SUMS</a>, <a href={`${RELEASE}/SHA256SUMS.sig`}>SHA256SUMS.sig</a> and <a href={`${RELEASE}/allowed_signers`}>allowed_signers</a> in one folder, then run:</p>
        <pre>{`ssh-keygen -Y verify -f allowed_signers -I gurtos -n gurtos-release -s SHA256SUMS.sig < SHA256SUMS
sha256sum -c SHA256SUMS --ignore-missing          # Linux
shasum -a 256 -c SHA256SUMS --ignore-missing      # macOS`}</pre>
        <p>The first line must say <code>Good "gurtos-release" signature for gurtos with ED25519 key SHA256:FWKFb1eAvEBmMhVJwMwTnLnhrmZ5yQZ5947pDvFKcpY</code>. That fingerprint is also at <code>release/allowed_signers</code> in the repository. On Windows, compare <code>Get-FileHash &lt;file&gt;.iso</code> with the line in <code>SHA256SUMS</code>. Every file is also on the <a href={`${REPO}/releases/tag/v0.2.0-preview`}>release page</a>.</p>
        <pre>{Object.entries(SUMS).map(([f, s]) => `${s}  ${f}`).join('\n')}</pre>
      </details>

      <details>
        <summary>What is inside, and the licences</summary>
        <p>Each image comes with a software bill of materials in CycloneDX, listing every package in it. The source has one in CycloneDX and one in SPDX. They are on the <a href={`${REPO}/releases/tag/v0.2.0-preview`}>release page</a>:</p>
        <ul>
          {['server-x86_64', 'server-arm64', 'personal-x86_64', 'personal-arm64'].map((n) => <li><a href={`${RELEASE}/gurtos-${n}.cdx.json.gz`}><code>gurtos-{n}.cdx.json.gz</code></a></li>)}
          <li><a href={`${RELEASE}/gurtos-source.cdx.json.gz`}><code>gurtos-source.cdx.json.gz</code></a> and <a href={`${RELEASE}/gurtos-source.spdx.json.gz`}><code>gurtos-source.spdx.json.gz</code></a></li>
        </ul>
        <p>The <a href={`${REPO}/blob/main/release/licenses.md`}>licence report</a> lists the licence of every part and flags the ones to check.</p>
      </details>

      <details>
        <summary>Minimum hardware</summary>
        <ul>
          <li>2 cores (4 recommended) and 4 GB of memory. At least 17 GB of disk for Server, 29 GB for Personal; the installer refuses a smaller disk.</li>
          <li>The box itself has run one task in 1 GB of memory. <a href="/docs/get-started/install-server/#why-it-is-light">Why Server is light</a>.</li>
          <li>x86_64 with BIOS or UEFI, or arm64 with UEFI. Secure Boot off, because the boot loader is not signed.</li>
          <li>Internet on first start. The box downloads Factory's Droid CLI, about 300 MB. Personal also downloads its voice model, about 600 MB with its Python environment.</li>
          <li>Server needs a wired network: it has no Wi-Fi. Personal uses wired or Wi-Fi.</li>
        </ul>
      </details>

      <details>
        <summary>Install steps</summary>
        <ol>
          <li>Write the ISO to a USB stick (balenaEtcher, or <code>sudo dd if=&lt;file&gt;.iso of=/dev/sdX bs=4M status=progress</code>), or attach it to a VM as its disc. On a cloud VM such as Vultr, add the ISO by its URL as a custom ISO.</li>
          <li>Start from it. On a computer with one empty disk it installs in a few minutes. With several disks it lists them and asks which one. A disk with data on it, or a USB disk, is erased only after you type <code>erase</code>.</li>
          <li>Setup asks for one model key, an Anthropic or a Factory API key. Agents never see it. Every other app is optional and off until you turn it on.</li>
          <li>Open Tasks, then New task.</li>
        </ol>
        <p>Full guides: <a href="/docs/get-started/install-server/">Install GurtOS Server</a>, <a href="/docs/get-started/install-personal/">Install GurtOS Personal</a> and <a href="/docs/get-started/first-task/">Your first task</a>.</p>
      </details>

      <details>
        <summary>Known limits</summary>
        <ul>
          <li>GurtOS Personal updates in place with <code>sudo box-update apply</code> and the <code>.sqfs</code> file for its edition and architecture, as the <a href={`${REPO}/releases/tag/v0.2.0-preview`}>release notes</a> say. GurtOS Server has no shell, and updates need one today, so moving a Server box to a newer release means reinstalling, which erases its disk.</li>
          <li>On Server, the first-boot setup clock reads UTC until the wizard's time zone step.</li>
          <li>On Personal, GNOME's first "Welcome!" page still shows Ubuntu's wallpaper behind it.</li>
          <li>Both editions include <code>age</code> for encrypted backups. The owner holds the key.</li>
          <li>The Mac and Android apps were not rebuilt for this release, so their files are from v0.1.0-preview. The <a href="/docs/project/changelog/">changelog</a> lists what changed in this release.</li>
        </ul>
      </details>

      <details>
        <summary>Build it from source</summary>
        <p>On an Ubuntu 24.04 machine or VM with root, 4 GB of memory and about 40 GB free for both editions:</p>
        <pre>{`git clone ${REPO}.git gurtos && cd gurtos
image/build                 # GurtOS Server for this machine's architecture
image/build personal        # GurtOS Personal`}</pre>
        <p>About 6 minutes for Server and 7 for Personal on a 4-core, 8 GB VM. See <a href={`${REPO}/blob/main/release/README.md`}>release/README.md</a>.</p>
      </details>
    </section>
  </div>
</Landing>

<script>
  // Pick the downloads for this computer. A Mac is assumed to be Apple silicon, because Intel Macs cannot run an
  // arm64 VM and the user agent does not say which Mac it is. Nothing is stored or sent.
  const RELEASE = 'https://github.com/benz16107/calhacks13/releases/download/v0.2.0-preview';
  const SIZES: Record<string, Record<string, string>> = {
    server: { x86_64: '1.37 GB', arm64: '1.36 GB' },
    personal: { x86_64: '2.00 GB', arm64: '1.99 GB' },
  };
  const ua = navigator.userAgent;
  const mac = /Macintosh|Mac OS X/.test(ua);
  const arm = mac || /aarch64|arm64|\barm\b/i.test(ua);
  const arch = arm ? 'arm64' : 'x86_64';
  document.querySelectorAll<HTMLAnchorElement>('.pick').forEach((a) => {
    const e = a.dataset.edition!;
    a.href = `${RELEASE}/gurtos-${e}-${arch}.iso`;
    a.querySelector('.pick-arch')!.textContent = arch;
    a.querySelector('.pick-size')!.textContent = SIZES[e][arch];
  });
  document.getElementById('detected')!.textContent = mac
    ? 'Showing arm64, for an Apple silicon Mac. Other options are below.'
    : arm
      ? 'Showing arm64, for an arm64 computer. Other options are below.'
      : 'Showing x86_64, for an Intel or AMD computer. Other options are below.';
  // A link to #verify-it opens the section.
  const open = () => {
    const d = document.querySelector<HTMLDetailsElement>(`details${location.hash || '#none'}`);
    if (d) d.open = true;
  };
  open();
  addEventListener('hashchange', open);
</script>

<style>
  .dl-page { padding-bottom: 2rem; }
  .top { padding: 3.5rem 0 2rem; }
  .top h1, .top .lead { max-width: 52rem; }
  .top h1 { margin-bottom: 1rem; }
  .lead { font-size: var(--gw-text-lg); color: var(--gw-ink-2); }
  .big { display: grid; gap: 1rem; margin-top: 2rem; }
  .pick { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.8rem 1.8rem; border-radius: var(--gw-radius); background: var(--gw-action); color: var(--gw-on-action); text-decoration: none; }
  .pick:hover { text-decoration: underline; }
  .pick:focus-visible { outline-color: var(--gw-link); }
  .pick-name { font-size: var(--gw-h2); font-weight: 700; }
  .pick-meta { font-family: var(--gw-mono); font-size: var(--gw-text-sm); opacity: 0.85; }
  .detected { margin-top: 0.9rem; color: var(--gw-ink-2); font-size: var(--gw-text-sm); }
  section h2 { font-size: var(--gw-h3); margin: 2.5rem 0 1rem; padding-top: 1.5rem; border-top: 1px solid var(--gw-rule); }
  .chooser th[scope='col'] { vertical-align: top; }
  .chooser .hint { display: block; font-weight: 400; font-size: var(--gw-text-sm); color: var(--gw-ink-2); max-width: 16rem; }
  .chooser tbody th { font-weight: 600; white-space: nowrap; }
  .chooser td, .chooser th { padding: 0.8rem 0.8rem 0.8rem 0; }
  .size { font-family: var(--gw-mono); font-size: var(--gw-text-sm); opacity: 0.8; margin-left: 0.3rem; }
  .sr { position: absolute; left: -999px; }
  .apps-lead { max-width: 46rem; color: var(--gw-ink-2); }
  .apps { margin: 1rem 0; }
  .apps > div { display: grid; gap: 0.4rem 2rem; padding: 1.1rem 0; border-top: 1px solid var(--gw-rule); }
  .apps dt { font-weight: 600; font-size: var(--gw-text-lg); }
  .apps dd { margin: 0; max-width: 46rem; }
  .apps dd p { margin: 0 0 0.6rem; }
  .apps dd .btn { margin-bottom: 0.8rem; }
  .apps code { word-break: break-all; font-size: 0.75rem; }
  .caveat { color: var(--gw-ink-2); font-size: var(--gw-text-sm); }
  @media (min-width: 900px) { .apps > div { grid-template-columns: 14rem 1fr; } }
  .details { margin-top: 2.5rem; border-bottom: 1px solid var(--gw-rule); }
  details { border-top: 1px solid var(--gw-rule); }
  summary { cursor: pointer; padding: 1rem 0; font-weight: 600; font-size: var(--gw-text-lg); }
  summary:focus-visible { outline: 3px solid var(--gw-link); outline-offset: 2px; }
  details[open] { padding-bottom: 1rem; }
  details p, details ul, details ol { max-width: 46rem; }
  details pre { font-size: 0.78rem; }
  @media (min-width: 900px) {
    .big { grid-template-columns: 1fr 1fr; }
  }
</style>
