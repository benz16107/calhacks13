---
// The home page: what GurtOS is, the three editions with a download block each, then the docs map.
import { Image } from 'astro:assets';
import { NAME, REPO } from '../product.ts';
import server from '../assets/home/server-screen.png';
import personal from '../assets/home/personal-everyday.png';
import businessDesktop from '../assets/home/business-desktop.png';
import businessPhone from '../assets/home/business-phone.png';

const RELEASE = `${REPO}/releases/download/v0.1.0-preview`;
const SUMS = {
  'gurtos-server-x86_64.iso': '1676fa7183f35b3ab7b5a9c695adb6d795efc0925aef32c314c884ba42d08c0a',
  'gurtos-server-arm64.iso': '07e3daca006faf892b9a3c2574536303888f36dbf29f38c8651f6a195b712377',
  'gurtos-personal-x86_64.iso': '0ba7ff5caa1bcc73073c94435131b48434a2128a46576320878ea77b2616bca3',
  'gurtos-personal-arm64.iso': '4d78deb9c879b9cc5325208d2e9e18c1d63e0620a7ebbbd2a559449ba8e7bbce',
};
const isos = (edition: string, x86: string, arm: string) => [
  { arch: 'x86_64', size: x86, file: `gurtos-${edition}-x86_64.iso`, for: 'Intel or AMD PC, server or cloud VM' },
  { arch: 'arm64', size: arm, file: `gurtos-${edition}-arm64.iso`, for: 'Apple silicon Mac in UTM or Parallels, or an arm64 server' },
];
---

<div class="home not-content">
  <section class="intro" aria-labelledby="home-h">
    <p class="eyebrow">{NAME} v0.1.0-preview · open source under Apache 2.0</p>
    <div class="intro-grid">
      <h1 id="home-h">An operating system where AI agents work safely</h1>
      <div class="intro-side">
        <p>
          Agents get real access to files, the web and money, and never hold your keys. Every task runs as its own
          Linux user, in its own copy of your files, and you can undo any one of them.
        </p>
        <p class="actions">
          <a class="btn primary" href="/download/">Download {NAME}</a>
          <a class="btn" href="/introduction/overview/">What is {NAME}?</a>
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="editions-h">
    <h2 id="editions-h" class="section-h">One core, three editions</h2>

    <article class="edition" id="server">
      <figure class="media">
        <Image src={server} alt="The GurtOS Server box screen: what needs you, what is running, what was spent today, and a dock of apps." widths={[720, 1440]} sizes="(max-width: 900px) 100vw, 640px" />
      </figure>
      <div class="text">
        <h3><span class="dot server" aria-hidden="true"></span>{NAME} Server</h3>
        <p>An always-on box at home or in the cloud. Agents work all day, and you watch from the box's own screen, a browser or your phone. There is no desktop and no user with sudo.</p>
        <p class="who"><strong>For</strong> anyone who wants agents working 24/7 on a machine they own, or a cloud instance.</p>
        <div class="dl" data-edition="server">
          {isos('server', '1.37 GB', '1.36 GB').map((f) => (
            <a class="iso" href={`${RELEASE}/${f.file}`} data-arch={f.arch}>
              <span class="iso-main">Download for {f.arch}</span>
              <span class="iso-sub">{f.size} · {f.for}</span>
            </a>
          ))}
        </div>
        <details class="sums">
          <summary>SHA-256 checksums and signature</summary>
          <pre>{`${SUMS['gurtos-server-x86_64.iso']}  gurtos-server-x86_64.iso\n${SUMS['gurtos-server-arm64.iso']}  gurtos-server-arm64.iso`}</pre>
          <p>The checksum file is signed. <a href="/download/#verify-it">How to verify it</a>.</p>
        </details>
      </div>
    </article>

    <article class="edition" id="personal">
      <figure class="media">
        <Image src={personal} alt="GurtOS Personal in everyday use: mail, a browser and Files open, while the GurtOS app and a notification ask to approve a $42.10 grocery order." widths={[720, 1440]} sizes="(max-width: 900px) 100vw, 640px" />
      </figure>
      <div class="text">
        <h3><span class="dot personal" aria-hidden="true"></span>{NAME} Personal</h3>
        <p>Your own laptop on GNOME, with your own account. Agents work beside you as separate users, on copies of your folders, and nothing changes until you choose Keep.</p>
        <p class="who"><strong>For</strong> people who want an AI computer of their own, for files, shopping and everyday errands.</p>
        <div class="dl" data-edition="personal">
          {isos('personal', '1.78 GB', '1.77 GB').map((f) => (
            <a class="iso" href={`${RELEASE}/${f.file}`} data-arch={f.arch}>
              <span class="iso-main">Download for {f.arch}</span>
              <span class="iso-sub">{f.size} · {f.for}</span>
            </a>
          ))}
        </div>
        <details class="sums">
          <summary>SHA-256 checksums and signature</summary>
          <pre>{`${SUMS['gurtos-personal-x86_64.iso']}  gurtos-personal-x86_64.iso\n${SUMS['gurtos-personal-arm64.iso']}  gurtos-personal-arm64.iso`}</pre>
          <p>The checksum file is signed. <a href="/download/#verify-it">How to verify it</a>.</p>
        </details>
      </div>
    </article>

    <article class="edition" id="business">
      <figure class="media duo">
        <Image class="desk" src={businessDesktop} alt="GurtOS Business: a $40,000 credit line Sam asked for waits for Rosa, the Controller, on her desktop." widths={[720, 1440]} sizes="(max-width: 900px) 100vw, 640px" />
        <Image class="phone" src={businessPhone} alt="The same $40,000 credit line on Rosa's phone, with Deny and Approve $40,000." widths={[180, 360]} sizes="(max-width: 900px) 25vw, 150px" />
      </figure>
      <div class="text">
        <h3><span class="dot business" aria-hidden="true"></span>{NAME} Business</h3>
        <p>One box shared by a team. People have roles, approvals go to whoever the rules allow, and an audit with CSV export and a kill switch show and stop what agents do. Shown on a made-up company, with sandbox data.</p>
        <p class="who"><strong>For</strong> a company that wants several people to supervise shared agents.</p>
        <div class="note">
          <p><strong>There is no Business download.</strong> Install Server or Personal above, then turn Business on from the owner's screen.</p>
          <p><a class="btn" href="/guides/turn-on-business/">How to turn on Business</a></p>
        </div>
      </div>
    </article>
  </section>

  <section aria-labelledby="core-h">
    <h2 id="core-h" class="section-h">What the core does</h2>
    <ul class="core">
      <li><a href="/concepts/workspaces-and-layers/">Undo one task</a> Each task's changes are a separate layer. Undo removes one and leaves the rest.</li>
      <li><a href="/concepts/vault-and-broker/">Keep keys out of reach</a> Tasks never hold a secret. Tools that need a key run inside the core.</li>
      <li><a href="/concepts/network-policy/">Limit the network</a> A task reaches only the hosts it names. The rest is refused and logged.</li>
      <li><a href="/concepts/approvals-and-budgets/">Pause for your OK</a> Spending above a budget waits for you, on the screen or your phone.</li>
      <li><a href="/concepts/action-log/">Record everything</a> One append-only log holds every step, tool call, approval and cost.</li>
      <li><a href="/concepts/resume-after-power-loss/">Survive a power cut</a> At boot the box rebuilds every task from the log and resumes.</li>
      <li><a href="/concepts/system-updates/">Update as a whole</a> A second system slot takes the update and rolls back if it is not healthy.</li>
    </ul>
  </section>

  <section aria-labelledby="way-h">
    <h2 id="way-h" class="section-h">Find your way</h2>
    <dl class="way">
      <div><dt>See which edition fits your job</dt><dd><a href="/introduction/use-cases/">Use cases by edition</a></dd></div>
      <div><dt>Install and run a first task</dt><dd><a href="/get-started/install-server/">Install GurtOS Server</a>, then <a href="/get-started/first-task/">Your first task</a></dd></div>
      <div><dt>Get a specific job done</dt><dd><a href="/guides/approve-from-your-phone/">How-to guides</a></dd></div>
      <div><dt>Understand how it works</dt><dd><a href="/concepts/architecture/">Architecture</a></dd></div>
      <div><dt>Look up an API, a file or a setting</dt><dd><a href="/reference/http-api/">HTTP API</a> and the rest of the reference</dd></div>
      <div><dt>Decide whether it is safe enough</dt><dd><a href="/security/model/">Security model</a> and <a href="/security/threat-model/">threat model</a></dd></div>
    </dl>
    <p class="preview">{NAME} is an early preview, open source under the Apache License 2.0, with the{' '}<a href={REPO}>source on GitHub</a>. Features that are not built are marked <strong>Planned</strong>; the{' '}<a href="/project/roadmap/">roadmap</a> lists them.</p>
  </section>
</div>

<script>
  // Mark the download that matches this computer. A Mac is assumed to be Apple silicon, because Intel Macs
  // cannot run an arm64 VM and the user agent does not say which Mac it is. No cookies, nothing is sent.
  const ua = navigator.userAgent;
  const mac = /Macintosh|Mac OS X/.test(ua);
  const arm = mac || /aarch64|arm64|\barm\b/i.test(ua);
  const want = arm ? 'arm64' : 'x86_64';
  document.querySelectorAll<HTMLAnchorElement>('.dl .iso').forEach((a) => {
    if (a.dataset.arch !== want) return;
    a.classList.add('suggested');
    a.querySelector('.iso-main')!.textContent += ' (suggested for this computer)';
  });
</script>

<style is:global>
  /* The splash template prints the page title; the home page has its own h1. */
  .content-panel:has(> .sl-container > #_top) { display: none; }
</style>

<style>
  .home {
    --paper: #f3f1ea;
    --rule: var(--sl-color-gray-5);
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 0 3rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .home h1, .home h2, .home h3 {
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    margin: 0;
  }
  .home p { margin: 0 0 0.9rem; }
  .eyebrow {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-accent);
    margin-bottom: 1rem !important;
  }
  .intro { padding: 2rem 0 2.5rem; }
  .intro-grid { display: grid; gap: 1.5rem 3rem; grid-template-columns: 1fr; align-items: end; }
  .intro h1 { font-size: clamp(2rem, 5vw, 3.4rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem !important; }
  .btn {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 6px;
    color: var(--sl-color-white);
    text-decoration: none;
    font-weight: 600;
  }
  .btn.primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-size: 1.1rem;
    padding: 0.8rem 1.4rem;
  }
  :root[data-theme='light'] .home a.btn.primary { color: #fbfaf6; }
  .btn:focus-visible, .iso:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 2px; }

  .section-h { font-size: 1.75rem; padding: 1.5rem 0 1.25rem; border-top: 2px solid var(--sl-color-white); }
  .edition {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 3rem;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }
  .media { margin: 0; align-self: start; }
  .media img { width: 100%; height: auto; display: block; border: 1px solid var(--rule); border-radius: 6px; }
  .duo { position: relative; padding-bottom: 2.5rem; padding-right: 3rem; }
  .duo .phone {
    position: absolute; right: 0; bottom: 0;
    width: 24% !important; border-width: 2px; background: var(--sl-color-black);
  }
  .text h3 { font-size: 1.6rem; display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .dot { width: 0.8rem; height: 0.8rem; border-radius: 2px; flex: none; }
  .dot.server { background: #46586b; outline: 1px solid var(--sl-color-gray-3); }
  .dot.personal { background: #f2b544; }
  .dot.business { background: #2d5784; outline: 1px solid var(--sl-color-gray-3); }
  .who strong { color: var(--sl-color-white); }

  .dl { display: grid; gap: 0.6rem; margin: 1.1rem 0 0.6rem; }
  .iso {
    display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 6px;
    text-decoration: none;
    color: var(--sl-color-white);
  }
  .iso.suggested { border: 2px solid var(--sl-color-accent); padding: calc(0.7rem - 1px) calc(0.95rem - 1px); }
  .iso-main { font-weight: 700; }
  .iso-sub { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .sums { font-size: var(--sl-text-sm); }
  .sums summary { cursor: pointer; color: var(--sl-color-gray-2); }
  .sums pre {
    font-family: var(--sl-font-mono); font-size: 0.72rem; overflow-x: auto;
    padding: 0.7rem; margin: 0.6rem 0; background: var(--sl-color-gray-6); border-radius: 4px;
  }
  .note { border: 1px solid var(--rule); border-radius: 6px; padding: 1rem 1.1rem 0.2rem; margin-top: 1.1rem; }

  .core { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .core li { padding: 0.8rem 0; border-top: 1px solid var(--rule); color: var(--sl-color-gray-2); }
  .core a { display: block; font-weight: 700; color: var(--sl-color-white); }
  .way { margin: 0 0 1.5rem; }
  .way > div { display: grid; gap: 0.15rem 2rem; padding: 0.8rem 0; border-top: 1px solid var(--rule); }
  .home a { color: var(--sl-color-accent-high); }
  .home a.btn.primary { color: var(--sl-color-black); }
  .way dt { color: var(--sl-color-white); font-weight: 600; }
  .way dd { margin: 0; }
  .preview { color: var(--sl-color-gray-2); border-top: 1px solid var(--rule); padding-top: 1rem; }

  @media (min-width: 900px) {
    .intro-grid { grid-template-columns: 7fr 5fr; }
    .edition { grid-template-columns: 7fr 5fr; }
    .dl { grid-template-columns: 1fr; }
    .core { grid-template-columns: 1fr 1fr; column-gap: 3rem; }
    .way > div { grid-template-columns: 5fr 7fr; }
  }
</style>
