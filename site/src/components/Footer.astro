---
// Starlight's pagination, then the footer shared with the other GurtOS sites.
import Default from '@astrojs/starlight/components/Footer.astro';
import SiteFooter from '../theme/SiteFooter.astro';
---

<Default />
<div class="docs-footer"><SiteFooter /></div>

<style is:global>
  /* Run the shared footer edge to edge below the docs' content column. */
  .docs-footer { margin: 2rem calc(-1 * var(--sl-content-pad-x)) calc(-1 * var(--sl-content-pad-x)); }
  .docs-footer .gw-footer { margin-top: 0; }
</style>
