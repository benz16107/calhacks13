---
// The home hero's picture: your folder, a task's own layer floating above it, the agent writing to the layer,
// then Keep merges it down or Undo lifts it away. SVG and CSS keyframes, a 13 s loop. The page pauses it
// (`.hero.paused`) when the hero is off screen or the tab is hidden.
---

<figure class="fig">
        <svg viewBox="0 0 520 340" role="img" aria-label="Your folder with a task's own layer floating above it. The task writes to the layer. Keep merges the layer into your folder, and Undo lifts it away, leaving your folder as it was.">
          <!-- Your folder -->
          <g transform="translate(0 196)">
            <g transform="translate(0 8)"><rect class="under" x="0" y="0" width="200" height="120" rx="8" transform="matrix(0.9 0.32 -0.9 0.32 224 0)" /></g>
            <g transform="matrix(0.9 0.32 -0.9 0.32 224 0)">
              <rect class="plate base" x="0" y="0" width="200" height="120" rx="8" />
              <rect class="file" x="16" y="18" width="110" height="9" rx="3" />
              <rect class="file" x="16" y="40" width="80" height="9" rx="3" />
              <rect class="file" x="16" y="62" width="130" height="9" rx="3" />
              <rect class="file" x="16" y="84" width="60" height="9" rx="3" />
              <rect class="file merged m1" x="16" y="102" width="90" height="9" rx="3" />
            </g>
            <text class="tag" x="104" y="42" text-anchor="end">Your folder</text>
          </g>
          <!-- The task's layer -->
          <g class="layer">
            <g transform="translate(0 100)">
              <g transform="translate(0 8)"><rect class="under lay" x="0" y="0" width="200" height="120" rx="8" transform="matrix(0.9 0.32 -0.9 0.32 224 0)" /></g>
              <g transform="matrix(0.9 0.32 -0.9 0.32 224 0)">
                <rect class="plate top" x="0" y="0" width="200" height="120" rx="8" />
                <rect class="wr w1" x="16" y="40" width="80" height="9" rx="3" />
                <rect class="wr w2" x="16" y="62" width="130" height="9" rx="3" />
                <rect class="wr w3" x="16" y="102" width="90" height="9" rx="3" />
              </g>
              <text class="tag t2" x="420" y="60">Task layer</text>
            </g>
          </g>
        </svg>
        <figcaption aria-hidden="true">
          <span class="c cap1">Your folder</span>
          <span class="c cap2">A task gets its own layer</span>
          <span class="c cap3">The agent writes to its layer, not to your folder</span>
          <span class="c cap4">Keep: the changes merge into your folder</span>
          <span class="c cap5">Undo: the layer lifts away and your folder stays as it was</span>
          <span class="cs">Keep merges the layer into your folder. Undo lifts it away.</span>
        </figcaption>
      </figure>

<style>
  .fig { margin: 0; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }

  .plate, .under { stroke-width: 1.5; }
  .base { fill: var(--gw-sunken); stroke: var(--gw-rule-strong); }
  .under { fill: var(--gw-rule); stroke: none; }
  .under.lay { fill: var(--gw-link); opacity: 0.45; }
  .top { fill: var(--gw-link-low); stroke: var(--gw-link); }
  .file { fill: var(--gw-ink-2); opacity: 0.5; }
  .wr { fill: var(--gw-link); transform-box: fill-box; transform-origin: left center; }
  .merged { opacity: 0; }
  .tag { font: 600 13px var(--gw-font); fill: var(--gw-ink-2); }
  .tag.t2 { fill: var(--gw-link); }

  figcaption { position: relative; height: 3.2rem; margin-top: 0.75rem; text-align: center; font-size: var(--gw-text-base); color: var(--gw-ink); }
  .c, .cs { position: absolute; inset: 0 0 auto; opacity: 0; }

  /* One 13 s cycle: Keep (0 to 6.5 s), then Undo (6.5 to 13 s). Percentages are of the cycle. */
  .layer { animation: lift 13s infinite both; }
  .wr.w1 { animation: w1 13s infinite both; } .wr.w2 { animation: w2 13s infinite both; } .wr.w3 { animation: w3 13s infinite both; }
  .m1 { animation: merge 13s infinite both; }
  .cap1 { animation: c1 13s infinite both; } .cap2 { animation: c2 13s infinite both; } .cap3 { animation: c3 13s infinite both; }
  .cap4 { animation: c4 13s infinite both; } .cap5 { animation: c5 13s infinite both; }

  @keyframes lift {
    0%, 6% { opacity: 0; transform: translateY(78px); animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    12.3%, 29.2% { opacity: 1; transform: none; animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1); }
    35% { opacity: 1; transform: translateY(78px); }
    37.5%, 50% { opacity: 0; transform: translateY(78px); animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    56%, 74% { opacity: 1; transform: none; animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1); }
    81%, 100% { opacity: 0; transform: translateY(-56px); }
  }
  @keyframes w1 { 0%, 15.4% { transform: scaleX(0); } 19.2%, 37.4% { transform: scaleX(1); } 37.5%, 59.2% { transform: scaleX(0); } 63%, 81% { transform: scaleX(1); } 81.1%, 100% { transform: scaleX(0); } }
  @keyframes w2 { 0%, 18.5% { transform: scaleX(0); } 22.3%, 37.4% { transform: scaleX(1); } 37.5%, 62.3% { transform: scaleX(0); } 66.1%, 81% { transform: scaleX(1); } 81.1%, 100% { transform: scaleX(0); } }
  @keyframes w3 { 0%, 21.5% { transform: scaleX(0); } 25.3%, 37.4% { transform: scaleX(1); } 37.5%, 65.3% { transform: scaleX(0); } 69.1%, 81% { transform: scaleX(1); } 81.1%, 100% { transform: scaleX(0); } }
  @keyframes merge { 0%, 33% { opacity: 0; } 38%, 95.4% { opacity: 0.5; } 100% { opacity: 0; } }
  @keyframes c1 { 0%, 4% { opacity: 1; } 5.4%, 100% { opacity: 0; } }
  @keyframes c2 { 0%, 6% { opacity: 0; } 7.5%, 13.5% { opacity: 1; } 14.6%, 49% { opacity: 0; } 51%, 56.5% { opacity: 1; } 58%, 100% { opacity: 0; } }
  @keyframes c3 { 0%, 14.6% { opacity: 0; } 16%, 27.5% { opacity: 1; } 28.5%, 58% { opacity: 0; } 59.5%, 71% { opacity: 1; } 72%, 100% { opacity: 0; } }
  @keyframes c4 { 0%, 28.5% { opacity: 0; } 30%, 46% { opacity: 1; } 48%, 100% { opacity: 0; } }
  @keyframes c5 { 0%, 72% { opacity: 0; } 74%, 92% { opacity: 1; } 94%, 100% { opacity: 0; } }

  /* A still: the layer floats above the folder with its changes written. */
  @media (prefers-reduced-motion: reduce) {
    .layer, .wr, .m1, .c { animation: none; }
    .c { display: none; }
    .cs { opacity: 1; }
  }
</style>
