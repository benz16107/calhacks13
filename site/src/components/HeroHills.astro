---
// A quiet backdrop for the home hero: three of the Hills wallpaper's layers (portal/src/kit/wallpaper.svg) at low
// contrast, drifting very slowly. The hero's data-phase (dawn, day, dusk, night, from the visitor's local time)
// tints them, so the page follows the same clock as the box screen. ?hour=21 previews another hour.
const layers = [
  { cls: 'l1', box: '0 520 1920 560', d: 'M0 640C300 560 520 600 760 570C1000 540 1250 520 1500 580C1750 640 1800 560 1920 590V1080H0V640Z' },
  { cls: 'l2', box: '0 600 1920 480', d: 'M0 720C260 650 520 700 820 660C1120 620 1300 690 1560 640C1820 590 1820 680 1920 660V1080H0V720Z' },
  { cls: 'l3', box: '0 730 1920 350', d: 'M0 820C300 760 640 800 960 770C1280 740 1500 800 1920 750V1080H0V820Z' },
];
---

<div class="hills" aria-hidden="true">
  {layers.map((l) => <svg class={`hill ${l.cls}`} viewBox={l.box} preserveAspectRatio="none"><path d={l.d} /></svg>)}
</div>

<script is:inline>
  // Inline so the tint is set before first paint. Pauses the hero's animation off screen and in a hidden tab.
  (() => {
    const hero = document.currentScript.closest('.hero');
    if (!hero) return;
    const q = new URLSearchParams(location.search).get('hour');
    const phase = () => {
      const d = new Date();
      const h = q !== null && !Number.isNaN(+q) ? +q : d.getHours() + d.getMinutes() / 60;
      hero.dataset.phase = h >= 5 && h < 8 ? 'dawn' : h >= 8 && h < 17 ? 'day' : h >= 17 && h < 20 ? 'dusk' : 'night';
    };
    phase();
    if (q === null) setInterval(phase, 60000);
    let inView = false;
    const update = () => hero.classList.toggle('paused', !inView || document.hidden);
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; update(); }).observe(hero);
    document.addEventListener('visibilitychange', update);
  })();
</script>

<style>
  .hills { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: 0.32; }
  .hill { position: absolute; bottom: 0; left: -6%; width: 112%; display: block; will-change: transform; animation: drift var(--dur) ease-in-out infinite alternate; animation-delay: var(--delay); }
  .hill path { fill: color-mix(in srgb, var(--c), var(--tint, transparent) var(--tint-amt, 0%)); transition: fill 1.2s; }
  .l1 { height: 52%; --c: var(--gw-hill-1); --amp: 2%; --dur: 140s; --delay: -40s; }
  .l2 { height: 40%; --c: var(--gw-hill-2); --amp: 3%; --dur: 110s; --delay: -75s; }
  .l3 { height: 27%; --c: var(--gw-hill-3); --amp: 4.5%; --dur: 85s; --delay: -20s; }
  @keyframes drift { from { transform: translate3d(calc(var(--amp) * -1), 0, 0); } to { transform: translate3d(var(--amp), 0, 0); } }
  @media (prefers-reduced-motion: reduce) { .hill { animation: none; } .hill path { transition: none; } }
</style>
