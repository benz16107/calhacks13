---
// The product pages outside the docs: the home page, Download, Terms and Privacy. Same OS theme as the docs, on warm paper.
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-600.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-400.css';
import { NAME, REPO, LICENSE_NAME } from '../product.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  frontmatter?: { title?: string; description?: string };
  prose?: boolean;
}
const { frontmatter, prose = !!Astro.props.frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? NAME;
const description = Astro.props.description ?? frontmatter?.description ?? '';
const image = Astro.props.image ?? '/og/index.png';
const canonical = new URL(Astro.url.pathname, Astro.site);
const full = title === NAME ? `${NAME}: an operating system where AI agents work safely` : `${title} | ${NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#27313F" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="GurtOS home"><span class="g">Gurt</span><span class="o">OS</span></a>
        <nav aria-label="Site">
          <a href="/#editions">Editions</a>
          <a href="/download/">Download</a>
          <a href={REPO}>GitHub</a>
          <a href="https://calhacks.gurtos.com/">Cal Hacks</a>
          <a class="docs-btn" href="/docs/">Docs</a>
        </nav>
      </div>
    </header>
    <main id="main">
      {prose ? <div class="wrap prose"><h1>{title}</h1><slot /></div> : <slot />}
    </main>
    <footer class="site">
      <div class="wrap bar">
        <p>{NAME} v0.1.0-preview <span aria-hidden="true">·</span> {LICENSE_NAME}</p>
        <nav aria-label="Footer">
          <a href="/download/">Download</a>
          <a href="/docs/">Docs</a>
          <a href={REPO}>GitHub</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --night: #27313f;
    --glass: #141a21;
    --moon: #e9dfc8;
    --on-night: #f2efe8;
    --on-night-2: #b9c0c8;
    --amber: #f2b544;
    --canvas: #f3f1ea;
    --surface: #fbfaf6;
    --sunken: #e6e7e1;
    --rule: #d3d6cf;
    --ink: #1c201d;
    --ink-2: #535a54;
    --focus: #2d5784;
    --font-sans: 'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'Atkinson Hyperlegible Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--canvas); color: var(--ink); font: 400 17px/1.6 var(--font-sans); }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--focus); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 2px; }
  h1, h2, h3 { font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; margin: 0; text-wrap: balance; }
  p { margin: 0 0 1rem; text-wrap: pretty; }
  code, pre { font-family: var(--font-mono); font-size: 0.86em; }
  :not(pre) > code { background: var(--sunken); padding: 0.1em 0.35em; border-radius: 4px; }
  pre { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 1rem; overflow-x: auto; }
  .wrap { width: min(76rem, 100% - 2rem); margin: 0 auto; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: 0.5rem 1rem; z-index: 10; }
  header.site, footer.site { background: var(--glass); color: var(--on-night); }
  footer.site { margin-top: 4rem; padding: 0.6rem 0; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; min-height: 52px; font-size: 0.9rem; }
  .bar p { margin: 0; color: var(--on-night-2); }
  .bar nav { display: flex; gap: 1.4rem; flex-wrap: wrap; align-items: center; }
  .bar nav a, .brand { color: var(--on-night); text-decoration: none; }
  .bar nav a:hover { text-decoration: underline; }
  .bar a:focus-visible { outline-color: var(--amber); }
  .brand { font-size: 1.15rem; letter-spacing: -0.02em; }
  .brand .g { font-weight: 700; }
  .docs-btn { border: 1px solid var(--on-night-2); border-radius: 6px; padding: 0.35rem 0.9rem; font-weight: 600; }
  .docs-btn:hover { text-decoration: none !important; background: var(--on-night); color: var(--glass) !important; }
  .prose { max-width: 50rem; padding-top: 2.5rem; }
  .prose h1 { font-size: 2.4rem; margin-bottom: 1.2rem; }
  .prose h2 { font-size: 1.5rem; margin: 2.2rem 0 0.8rem; }
  .prose table { border-collapse: collapse; width: 100%; font-size: 0.92rem; display: block; overflow-x: auto; }
  .prose th, .prose td { text-align: left; padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose ul, .prose ol { padding-left: 1.4rem; }
  .prose li { margin-bottom: 0.4rem; }
</style>
