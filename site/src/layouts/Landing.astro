---
// The product pages outside the docs: the home page, Download, Terms and Privacy. Same OS theme as the docs, on warm paper.
import '../theme/tokens.css';
import '../theme/base.css';
import ThemeScript from '../theme/ThemeScript.astro';
import SiteHeader from '../theme/SiteHeader.astro';
import SiteFooter from '../theme/SiteFooter.astro';
import { NAME } from '../product.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  frontmatter?: { title?: string; description?: string };
  prose?: boolean;
}
const { frontmatter, prose = !!Astro.props.frontmatter } = Astro.props;
const current = Astro.url.pathname.startsWith('/download') ? 'download' : '';
const title = Astro.props.title ?? frontmatter?.title ?? NAME;
const description = Astro.props.description ?? frontmatter?.description ?? '';
const image = Astro.props.image ?? '/og/index.png';
const canonical = new URL(Astro.url.pathname, Astro.site);
const full = title === NAME ? `${NAME}: an operating system where AI agents work safely` : `${title} | ${NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#27313F" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <ThemeScript />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main">
      {prose ? <div class="wrap prose"><h1>{title}</h1><slot /></div> : <slot />}
    </main>
    <SiteFooter />
  </body>
</html>
