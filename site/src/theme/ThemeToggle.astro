---
// The light and dark switch. Keeps its choice in localStorage and in a cookie shared by the gurtos.com sites.
---
<button type="button" class="gw-theme" aria-label="Switch to dark mode" title="Switch theme">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
</button>

<script>
  const root = document.documentElement;
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll<HTMLButtonElement>('.gw-theme').forEach((b) => {
      b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    });
  };
  const save = (t: string) => {
    try { localStorage.setItem('gurtos-theme', t); } catch {}
    if (/(^|\.)gurtos\.com$/.test(location.hostname)) {
      document.cookie = `gurtos-theme=${t}; Domain=.gurtos.com; Path=/; Max-Age=31536000; SameSite=Lax; Secure`;
    }
  };
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('.gw-theme')) return;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    save(next);
    sync();
  });
  // Follow the system setting until the visitor has chosen.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('gurtos-theme'); } catch {}
    if (saved) return;
    root.dataset.theme = e.matches ? 'dark' : 'light';
    sync();
  });
  sync();
</script>

<style is:global>
  .gw-theme { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: 1px solid var(--gw-on-glass-2); border-radius: var(--gw-radius); background: transparent; color: var(--gw-on-glass); cursor: pointer; }
  .gw-theme:hover { background: var(--gw-on-glass); color: var(--gw-glass); }
  .gw-theme:focus-visible { outline: 3px solid var(--gw-amber); outline-offset: 2px; }
  .gw-theme .moon { display: none; }
  :root[data-theme='light'] .gw-theme .sun { display: none; }
  :root[data-theme='light'] .gw-theme .moon { display: block; }
</style>
