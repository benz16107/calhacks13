---
// A plain display, shared by the GurtOS sites: a thin black bezel around a 16:10 screen. The screenshot fills the
// screen edge to edge. Capture at 16:10 (1680x1050, 1440x900 or 1280x800); a wider one loses a little at each side.
// `dark` is the same screen in dark mode; the page theme picks one. The frame fills the width of its parent.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  sizes?: string;
  // which part to keep when the screenshot is wider than 16:10, as CSS object-position
  focus?: string;
  // load at once: for the first screenshot on a page, which is often the largest thing on screen
  priority?: boolean;
}
const { src, dark, alt, sizes = '(max-width: 900px) 100vw, 640px', focus = '50% 50%', priority = false } = Astro.props;
const load = priority ? { loading: 'eager' as const, fetchpriority: 'high' as const } : {};
---
<div class="gw-display">
  <div class="gw-display-body">
    <div class="gw-display-screen" style={`--focus:${focus}`}>
      <Image class="gw-light" src={src} alt={alt} widths={[720, 1440]} sizes={sizes} {...load} />
      {dark && <Image class="gw-dark" src={dark} alt="" aria-hidden="true" widths={[720, 1440]} sizes={sizes} />}
    </div>
  </div>
</div>

<style is:global>
  .gw-display { container-type: inline-size; width: 100%; }
  .gw-display-body { padding: 1.4cqw; background: #0b0e12; border-radius: 1.8cqw; box-shadow: 0 0 0 1px #5b6672; }
  .gw-display-screen { aspect-ratio: 16 / 10; background: #000; border-radius: 0.5cqw; overflow: hidden; }
  .gw-display-screen img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--focus); border: 0; border-radius: 0; }
  .gw-display-screen img.gw-dark { display: none; }
  :root[data-theme='dark'] .gw-display-screen img.gw-dark { display: block; }
  :root[data-theme='dark'] .gw-display-screen:has(.gw-dark) img.gw-light { display: none; }
</style>
