---
// A plain display, shared by the GurtOS sites: a thin black bezel around a 16:10 screen. A screenshot of another shape
// is letterboxed in black inside it, so every desktop shot on a page has the same size and nothing is cropped.
// The frame fills the width of its parent.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
}
const { src, alt, sizes = '(max-width: 900px) 100vw, 640px' } = Astro.props;
---
<div class="gw-display">
  <div class="gw-display-body">
    <div class="gw-display-screen"><Image src={src} alt={alt} widths={[720, 1440]} sizes={sizes} /></div>
  </div>
</div>

<style is:global>
  .gw-display { container-type: inline-size; width: 100%; }
  .gw-display-body { padding: 1.4cqw; background: #0b0e12; border-radius: 1.8cqw; box-shadow: 0 0 0 1px #5b6672; }
  .gw-display-screen { aspect-ratio: 16 / 10; background: #000; border-radius: 0.5cqw; overflow: hidden; }
  .gw-display-screen img { display: block; width: 100%; height: 100%; object-fit: contain; border: 0; border-radius: 0; }
</style>
