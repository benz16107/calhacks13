{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/install(/?)",
      "destination": "https://raw.githubusercontent.com/benz16107/calhacks13/main/tracks/anthropic/install.sh",
      "permanent": false
    },
    {
      "source": "/project/terms(/?)",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/project/privacy(/?)",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/(introduction|get-started|concepts|guides|reference|security|project)/(.*)",
      "destination": "/docs/$1/$2",
      "permanent": true
    },
    {
      "source": "/og/(introduction|get-started|concepts|guides|reference|security|project)/(.*)",
      "destination": "/og/docs/$1/$2",
      "permanent": true
    }
  ]
}
